{
  "name": "suhas-darsi-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.23.4 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "bun run build && bunx wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests worker scripts *.config.*",
    "test:browser": "playwright test",
    "fonts": "playwright test tests/browser/fonts.spec.ts --reporter=line",
    "verify": "vitest run tests/quality && playwright test tests/browser/styling.spec.ts tests/browser/readability.spec.ts",
    "typecheck": "astro check",
    "deadcode": "knip",
    "notes": "bun scripts/notes.ts",
    "check": "bun run lint && bun run typecheck && bun run deadcode && bun run test && bun run test:browser",
    "prepare": "git config core.hooksPath scripts/git-hooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "d3-force": "^3.0.1",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "@types/d3-force": "^3.0.10",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "jsqr": "^1.4.0",
    "knip": "^6.46.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "4.164.0"
  }
}

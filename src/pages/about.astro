---
import CopyEmail from '../components/CopyEmail.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { roles, site } from '../site/site';
import { person } from '../site/structured-data';

const currently = roles.filter((r) => r.current);
const previously = roles.filter((r) => !r.current);
---

<SiteLayout pageType="AboutPage" jsonLd={[person()]} title="About Suhas Darsi — Founder and AI Security Writer" description="About Suhas Darsi — founder, researcher, and writer working on AI security." current="about">
  <section class="page-head" style="gap: 24px;">
    <h1 class="title">About</h1>
    <div class="bio">
      <p>Suhas Darsi is a co-founder of SuperAlign who writes about how AI systems fail and how to deploy them safely.</p>
      <p><b>I'm a co-founder at <a class="tlink" href="https://superalign.ai/">SuperAlign</a></b>, where we help security teams see, understand, and control AI adoption across their organizations.</p>
      <p>My background is in Computer Vision research at IIIT Hyderabad. These days I focus on how AI systems fail, how risk propagates through connected agents, and the controls required to deploy them safely.</p>
      <p>This site is where I publish long-form notes on AI security, agent architecture, and the network dynamics behind systemic failures.</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 16px; color: var(--muted);">
      <CopyEmail />
      <a href={site.linkedin}>LinkedIn</a>
      <a href={site.x}>X</a>
      <a href={site.booking}>Book a time to talk</a>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label"><h2>Currently</h2></div>
    <div class="rows">
      {currently.map((r) => <a class="mrow" href={r.url} target="_blank" rel="noopener noreferrer"><span>{r.name}</span><span class="l">{r.role} ↗</span></a>)}
    </div>
  </section>
  <section class="sec" style="padding-bottom: 64px;">
    <div class="sec-label"><h2>Previously</h2></div>
    <div class="rows">
      {previously.map((r) => <a class="mrow" href={r.url} target="_blank" rel="noopener noreferrer"><span>{r.name}</span><span class="l">{r.role} ↗</span></a>)}
    </div>
  </section>
</SiteLayout>

<style is:global>
  .bio { font-size: 16px; line-height: 1.7; color: var(--body); max-width: 62ch; display: grid; gap: 16px; }
  .bio p:first-child { font-family: "Geist Serif", serif; font-size: 28px; line-height: 1.3; letter-spacing: -.012em; color: var(--ink); }
  .bio b { color: var(--ink); font-weight: 500; }
</style>

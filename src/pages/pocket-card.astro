---
import SiteLayout from '../layouts/SiteLayout.astro';

type Field = { name: string; label: string; placeholder: string; type?: 'text' | 'tel' | 'email' | 'url'; autocomplete?: string };
// Each group is a list of rows; a row with two fields sits side by side.
const groups: { legend: string; rows: Field[][] }[] = [
  { legend: 'You', rows: [
    [{ name: 'name', label: 'Full name', placeholder: 'Ada Lovelace', autocomplete: 'name' }],
    [{ name: 'title', label: 'Role', placeholder: 'Engineer', autocomplete: 'organization-title' },
      { name: 'company', label: 'Company', placeholder: 'Analytical Engines', autocomplete: 'organization' }],
  ] },
  { legend: 'Reach', rows: [
    [{ name: 'phone', label: 'Phone (+country code)', placeholder: '+65 …', type: 'tel', autocomplete: 'tel' },
      { name: 'email', label: 'Email', placeholder: 'you@example.com', type: 'email', autocomplete: 'email' }],
  ] },
  { legend: 'Links', rows: [
    [{ name: 'website', label: 'Website URL', placeholder: 'https://', type: 'url', autocomplete: 'url' }],
    [{ name: 'linkedin', label: 'LinkedIn URL', placeholder: 'https://linkedin.com/in/…', type: 'url' },
      { name: 'twitter', label: 'X / Twitter URL', placeholder: 'https://x.com/…', type: 'url' }],
  ] },
  { legend: 'Other details', rows: [
    [{ name: 'note', label: 'Anything else to show on the back', placeholder: 'Pronouns, timezone, a line about you' }],
  ] },
];
---

<SiteLayout title="Pocket Card — Suhas Darsi" description="Make a contact card for Apple Wallet and share it with a scan." noindex current="apps">
  <section class="page-head">
    <span class="eyebrow">Tiny app</span>
    <h1 class="title">Pocket Card</h1>
    <p class="lede">Your business card, in Apple Wallet. Fill it in, download it, share it with a scan.</p>
  </section>

  <div class="app-grid" style="padding-bottom: 64px;">
    <form id="contact-form" class="form" novalidate>
      {groups.map((group) => (
        <fieldset class="group">
          <legend>{group.legend}</legend>
          {group.rows.map((row) => {
            const fields = row.map((field) => (
              <label class="lab" for={field.name}>{field.label}<input id={field.name} name={field.name} class="field plain" type={field.type ?? 'text'} placeholder={field.placeholder}
                maxlength={field.name === 'note' ? 240 : 160} autocomplete={field.autocomplete ?? 'off'} spellcheck="false" required={field.name === 'name'} /></label>
            ));
            return row.length > 1 ? <div class="two">{fields}</div> : fields;
          })}
        </fieldset>
      ))}
    </form>

    <aside class="preview" aria-label="Live preview">
      <div class="pass" id="wallet-preview">
        <div style="display: grid; gap: 8px;">
          <span class="pk">Pocket Card</span>
          <span class="pn" id="preview-name">Your name</span>
          <span class="pr" id="preview-role">Role</span>
        </div>
        <div class="row">
          <div><span>Phone</span><span id="preview-phone">—</span></div>
          <div><span>Email</span><span id="preview-email">—</span></div>
        </div>
        <img id="contact-qr" class="qr" width="720" height="720" alt="QR code for your contact" hidden />
        <div id="qr-placeholder" class="qr-empty">Add your name to create your QR.</div>
      </div>
      <p class="faint" style="font-size: 13px; text-align: center;">Live preview. Apple Wallet sets the final layout.</p>
      <button id="save-wallet" type="button" class="btn dark" disabled><span class="btn-label">Download for Apple Wallet</span></button>
      <div class="two">
        <button id="save-qr" type="button" class="btn" disabled>Save QR</button>
        <button id="save-contact" type="button" class="btn" disabled>Download contact</button>
      </div>
      <p id="contact-status" role="status" aria-live="polite"></p>
      <p class="muted" style="font-size: 13px; line-height: 1.55;">Nothing is saved. Your details go to a signing service only to create the Wallet file, and the card works offline once added. Anyone who scans your QR can read its details. On Android, scan the QR or import the contact file instead.</p>
      <noscript><p class="muted" style="font-size: 13px;">Enable JavaScript to create your card.</p></noscript>
    </aside>
  </div>
</SiteLayout>

<script>
  import QRCode from 'qrcode';
  import { cardRoleLine, contactFields, generateVCard, validateContact } from '../utils/contact-card';
  const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const status = $('#contact-status');
  const image = $<HTMLImageElement>('#contact-qr');
  const placeholder = $('#qr-placeholder');
  const form = $<HTMLFormElement>('#contact-form');
  const actions = ['#save-wallet', '#save-qr', '#save-contact'].map((selector) => $<HTMLButtonElement>(selector));
  const inputs = Object.fromEntries(contactFields.map((name) => [name, $<HTMLInputElement>(`#${name}`)]));
  const read = () => validateContact(Object.fromEntries(contactFields.map((name) => [name, inputs[name].value])));
  const message = (error: unknown, tone: 'error' | 'info' = error instanceof Error ? 'error' : 'info') => {
    status.textContent = error instanceof Error ? error.message : String(error); status.dataset.tone = tone;
  };
  function flash(button: HTMLButtonElement, text: string, ms = 1600) {
    const label = button.dataset.label ??= button.textContent!.trim();
    button.textContent = text;
    clearTimeout(Number(button.dataset.timer));
    button.dataset.timer = String(setTimeout(() => { button.textContent = label; }, ms));
  }
  function download(data: Blob | string, name: string) {
    const url = typeof data === 'string' ? data : URL.createObjectURL(data); const link = document.createElement('a');
    link.href = url; link.download = name; document.body.append(link); link.click(); link.remove();
    if (typeof data !== 'string') setTimeout(() => URL.revokeObjectURL(url), 60_000);
  }

  // Text on the card mirrors the raw inputs instantly; the QR only follows valid details.
  let busy = false;
  function render() {
    const value = (name: string) => inputs[name].value.trim();
    $('#preview-name').textContent = value('name') || 'Your name';
    $('#preview-role').textContent = cardRoleLine({ title: value('title'), company: value('company') }).value || 'Role';
    $('#preview-phone').textContent = value('phone') || '—';
    $('#preview-email').textContent = value('email') || '—';
    for (const button of actions) button.disabled = busy || !value('name');
  }
  let generation = 0;
  async function preview() {
    const ticket = ++generation; const d = read();
    const src = await QRCode.toDataURL(generateVCard(d), { width: 720, margin: 2, errorCorrectionLevel: 'M', color: { dark: '#16171a', light: '#ffffff' } });
    if (ticket !== generation) return;
    image.src = src; image.hidden = false; placeholder.hidden = true;
  }
  async function refresh(announce: boolean) {
    render();
    try { await preview(); if (status.dataset.tone === 'error') message(''); }
    catch (error) {
      generation++; image.hidden = true; placeholder.hidden = false;
      placeholder.textContent = inputs.name.value.trim() ? 'Check the highlighted details to update your QR.' : 'Add your name to create your QR.';
      if (announce && inputs.name.value.trim()) message(error);
    }
  }
  let timer: ReturnType<typeof setTimeout>;
  form.addEventListener('input', () => { render(); clearTimeout(timer); timer = setTimeout(() => void refresh(false), 200); });
  form.addEventListener('change', () => { clearTimeout(timer); void refresh(true); });
  form.addEventListener('submit', (event) => event.preventDefault());

  const on = (selector: string, fn: () => Promise<void> | void) => $(selector).addEventListener('click', () => Promise.resolve().then(fn).catch((error) => message(error)));
  on('#save-qr', async () => { await preview(); download(image.src, 'contact-qr.png'); flash($('#save-qr'), 'Saved ✓'); });
  on('#save-contact', () => { download(new Blob([generateVCard(read())], { type: 'text/vcard;charset=utf-8' }), 'contact.vcf'); flash($('#save-contact'), 'Saved ✓'); });
  on('#save-wallet', async () => {
    // Every download is a fresh card; the ID only exists to identify this pass.
    const payload = { version: 1, id: crypto.randomUUID(), contact: read() };
    const label = $('#save-wallet .btn-label'); const idle = label.textContent!;
    busy = true; render(); label.textContent = 'Creating your card…'; message('Creating your Wallet card…');
    try {
      const response = await fetch('/api/wallet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!response.ok) { const error = await response.json().catch(() => null); throw new Error(error?.error ?? 'Wallet service unavailable. QR and contact downloads still work.'); }
      if (!response.headers.get('content-type')?.includes('application/vnd.apple.pkpass')) throw new Error('Wallet generation is not activated yet.');
      download(await response.blob(), 'contact.pkpass'); message('Downloaded. Open it on your iPhone and choose Add to Wallet.');
    } finally {
      busy = false; render(); label.textContent = idle;
    }
  });
  render();
</script>

<style is:global>
  .app-grid { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .app-grid .form { flex: 999 1 460px; min-width: 0; display: grid; gap: 24px; }
  .preview { flex: 1 1 320px; max-width: 380px; display: grid; gap: 12px; }
  .group { display: grid; gap: 12px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .group legend { font-size: 16px; font-weight: 500; margin-bottom: 4px; padding: 0; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .lab { display: grid; gap: 8px; font-size: 13px; color: var(--muted); }
  .lab .field:user-invalid { border-color: var(--alert); }
  .pass { border-radius: 20px; background: var(--ink); color: var(--bg); padding: 24px; display: grid; gap: 16px; aspect-ratio: 1 / 1.35; max-width: 100%; align-content: space-between; }
  .pass [hidden] { display: none; }
  .pass .pk { font-family: Geist, sans-serif; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; opacity: .6; }
  .pass .pn { font-size: 28px; font-weight: 600; letter-spacing: -.015em; line-height: 1.15; overflow-wrap: anywhere; }
  .pass .pr { font-size: 16px; opacity: .72; overflow-wrap: anywhere; }
  .pass .row { overflow-wrap: anywhere; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; font-size: 13px; }
  .pass .row span:first-child { display: block; font-family: Geist, sans-serif; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; opacity: .7; }
  .pass .qr { justify-self: center; width: 160px; height: auto; padding: 8px; background: #ffffff; border-radius: 8px; }
  .qr-empty { justify-self: center; width: 121px; height: 121px; border-radius: 8px; border: 1px dashed color-mix(in srgb, var(--bg) 40%, transparent); display: grid; place-items: center; text-align: center; font-size: 13px; opacity: .7; padding: 8px; }
  .preview .btn:disabled { cursor: not-allowed; }
  #contact-status { font-size: 13px; color: var(--accent-text); }
  #contact-status:empty { display: none; }
  #contact-status[data-tone='error'] { color: var(--alert); }
  @media (max-width: 640px) { .two { grid-template-columns: minmax(0, 1fr); } .preview { max-width: none; } }
</style>

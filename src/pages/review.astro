---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCurrentReviewItem, getWaitingReviewItems } from '../utils/editorial-queue';

if (import.meta.env.PROD) {
  return Astro.rewrite('/404');
}

const currentMeta = getCurrentReviewItem();
const waiting = getWaitingReviewItems();
const drafts = await getCollection('blog');
const currentPost = currentMeta ? drafts.find((post) => post.id === currentMeta.id) : undefined;

if (!currentPost || !currentMeta) {
  return Astro.rewrite('/404');
}

const { Content } = await render(currentPost);
---

<BlogLayout title={`Review: ${currentPost.data.title} | Suhas Darsi`} description="Private editorial review queue. Unpublished drafts only." noindex>
  <p class="review-banner">Review queue — not public. Drafts stay unpublished until <code>draft: true</code> is removed. This page is omitted from production.</p>

  <div class="review-brief">
    <p><span class="review-label">Now reviewing</span> 1 of {waiting.length + 1}</p>
    <h1 class="page-heading review-heading">{currentPost.data.title}</h1>
    <dl class="review-meta">
      <div>
        <dt>Siftly topic</dt>
        <dd>{currentMeta.siftlyTopic}</dd>
      </div>
      <div>
        <dt>Why this topic</dt>
        <dd>{currentMeta.why}</dd>
      </div>
      <div>
        <dt>Review slot</dt>
        <dd>
          <time datetime={currentMeta.reviewSlot}>{currentMeta.reviewSlot}</time>
        </dd>
      </div>
      <div>
        <dt>Proposed publish</dt>
        <dd>
          <time datetime={currentMeta.proposedPublish}>{currentMeta.proposedPublish}</time>
          <span class="review-note"> after approval — will not go live on this date by itself</span>
        </dd>
      </div>
    </dl>
  </div>

  <article class="review-draft">
    <h2 class="section-heading">Draft</h2>
    <p class="review-dek">{currentPost.data.description}</p>
    <div class="prose-custom">
      <Content />
    </div>
  </article>

  {waiting.length > 0 && (
    <section class="review-waiting" aria-label="Scheduled drafts waiting for review">
      <h2 class="section-heading">Waiting for review</h2>
      <ol class="waiting-list">
        {waiting.map((item) => (
          <li>
            <span class="waiting-title">{drafts.find((post) => post.id === item.id)?.data.title ?? item.id}</span>
            <span class="waiting-slot">
              {item.siftlyTopic} · review {item.reviewSlot} · proposed publish {item.proposedPublish}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )}
</BlogLayout>

<style>
  .review-banner {
    margin: 0 0 2rem;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    background: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-body-text);
  }

  .review-brief {
    margin-bottom: 3rem;
  }

  .review-label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }

  .review-heading {
    margin: 0 0 1.25rem;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .review-meta div {
    margin: 0;
  }

  .review-meta dt {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    margin-bottom: 0.25rem;
  }

  .review-meta dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-body-text);
  }

  .review-note {
    color: var(--color-muted-foreground);
  }

  .review-dek {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-body-text);
    margin: 0 0 1.5rem;
  }

  .review-draft {
    margin-bottom: 3rem;
  }

  .section-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    margin: 0 0 1rem;
  }

  .waiting-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .waiting-title {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .waiting-slot {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
  }
</style>

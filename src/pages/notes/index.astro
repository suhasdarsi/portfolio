---
import { getPublishedBlogEntriesByDate } from '../../utils/content';
import { formatDate } from '../../utils/date';

import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = await getPublishedBlogEntriesByDate();
---

<BlogLayout title="AI Security Notes | Suhas Darsi" description="Practical field notes on AI security, agent systems, and network risk.">
  <header class="notes-header">
    <h1 class="page-heading">AI security field notes</h1>
    <p class="page-intro">Practical essays on how AI systems fail, how attacks propagate through connected agents, and how builders can contain the risk.</p>
  </header>

  <form class="notes-search" role="search" action="/notes">
    <label for="notes-query" class="sr-only">Search notes</label>
    <div class="notes-search-controls">
      <svg class="notes-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input id="notes-query" class="field" name="q" type="search" placeholder="Search titles and full text" />
      <button type="submit" class="button-quiet">Search</button>
    </div>
    <p id="notes-search-status" role="status"></p>
  </form>

  <h2 class="section-label">All notes <span class="section-count">{posts.length}</span></h2>
  <ul class="rows note-list" id="note-list">
    {posts.map((post) => (
      <li class="note-item" data-note-id={post.id}>
        <a href={`/notes/${post.id}`} class="row note-link">
          <span class="note-body">
            <span class="row-title note-title">{post.data.title}</span>
            <span class="note-desc">{post.data.description}</span>
          </span>
          <time class="row-meta" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </a>
      </li>
    ))}
    {posts.length === 0 && <li>No notes found.</li>}
  </ul>
</BlogLayout>

<script>
  import { searchDocuments } from '../../utils/client-search';
  import { highlightText, searchExcerpt } from '../../utils/search-display';
  import { createSearchLoader } from '../../utils/search-loader';
  import type { SearchEntry } from '../../utils/search';

  const form = document.querySelector<HTMLFormElement>('.notes-search')!;
  const input = document.querySelector<HTMLInputElement>('#notes-query')!;
  const status = document.querySelector<HTMLElement>('#notes-search-status')!;
  const list = document.querySelector<HTMLElement>('#note-list')!;
  const articles = Array.from(list.querySelectorAll<HTMLElement>('[data-note-id]'));
  const originals = articles.map((article) => ({
    article,
    title: article.querySelector('.note-title')!.textContent!.trim(),
    description: article.querySelector('.note-desc')!.textContent!.trim(),
  }));
  const loadSearch = createSearchLoader<SearchEntry>();
  let version = 0;

  async function applySearch(query: string) {
    const current = ++version;
    input.value = query;
    if (!query.trim()) {
      originals.forEach(({ article, title, description }) => {
        article.hidden = false;
        article.querySelector('.note-title')!.textContent = title;
        article.querySelector('.note-desc')!.textContent = description;
        list.append(article);
      });
      status.textContent = '';
      return;
    }
    status.textContent = 'Searching notes…';
    try {
      const documents = await loadSearch();
      if (current !== version) return;
      const results = searchDocuments(documents, query);
      articles.forEach((article) => { article.hidden = true; });
      results.forEach((result) => {
        const article = articles.find((item) => item.dataset.noteId === result.id);
        if (!article) return;
        article.hidden = false;
        highlightText(article.querySelector<HTMLElement>('.note-title')!, result.title, query);
        highlightText(article.querySelector<HTMLElement>('.note-desc')!, searchExcerpt(result.body, query, result.description), query);
        list.append(article);
      });
      status.textContent = results.length ? `${results.length} ${results.length === 1 ? 'note' : 'notes'} found` : 'No notes match. Try different words.';
    } catch {
      if (current !== version) return;
      status.textContent = 'Search is unavailable. Submit again to retry.';
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const url = new URL(window.location.href);
    const query = input.value.trim();
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    if (url.href !== window.location.href) history.pushState(null, '', url);
    void applySearch(query);
  });
  window.addEventListener('popstate', () => void applySearch(new URLSearchParams(location.search).get('q') ?? ''));
  void applySearch(new URLSearchParams(location.search).get('q') ?? '');
</script>

<style>
  .notes-header { margin-bottom: 2.5rem; }
  .notes-search { margin-bottom: 2.5rem; }
  .notes-search-controls { position: relative; display: flex; align-items: center; }
  .notes-search-icon { position: absolute; left: 0.875rem; color: var(--color-muted-foreground); pointer-events: none; }
  .notes-search .field { padding-left: 2.5rem; padding-right: 5.5rem; }
  .notes-search .button-quiet { position: absolute; right: 0.25rem; padding: 0.375rem 0.75rem; }
  #notes-search-status { margin-top: 0.75rem; color: var(--color-muted-foreground); }
  #notes-search-status:empty { display: none; }
  .note-item[hidden] { display: none; }
  .note-body { display: grid; gap: 0.25rem; min-width: 0; }
  .note-title { text-wrap: balance; }
  .note-title { font-weight: 700; }
  .note-desc { font-family: var(--font-serif); color: var(--color-muted-foreground); line-height: 1.55; text-wrap: pretty; }
  .note-link { padding-block: 1rem; }
  .note-link:hover .note-title { text-decoration: underline; text-decoration-color: var(--color-slate); text-underline-offset: 3px; }
  @media (max-width: 520px) {
    .note-link { flex-direction: column-reverse; gap: 0.25rem; }
  }
</style>

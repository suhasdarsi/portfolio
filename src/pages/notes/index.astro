---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getNoteLinks, getNotes, noteHref, readingTime } from '../../notes/notes';
import { formatDate } from '../../site/format';

const posts = await getNotes();
const links = getNoteLinks(posts);
const plural = (n: number) => `${n} ${n === 1 ? 'note' : 'notes'}`;

const topics = new Map<string, number>();
for (const post of posts) {
  for (const topic of post.data.topics) topics.set(topic, (topics.get(topic) ?? 0) + 1);
}
const chips = [{ label: 'All', count: posts.length }, ...[...topics].map(([label, count]) => ({ label, count }))];

const notes = posts.map((post) => {
  const backlinks = links.get(post.id)!.linkedFrom.length;
  return {
    id: post.id,
    href: noteHref(post.id),
    title: post.data.title,
    desc: post.data.description,
    date: formatDate(post.data.pubDate),
    datetime: post.data.pubDate.toISOString(),
    topics: post.data.topics.join('|'),
    meta: `${readingTime(post)} · linked from ${plural(backlinks)}`,
  };
});
---

<SiteLayout
  title="Notes on AI Security and Agent Systems — Suhas Darsi"
  description="Practical field notes on AI security, agent systems, and network risk."
  current="notes"
>
  <section class="page-head">
    <h1 class="title">Notes</h1>
    <p class="lede">A small garden of notes on AI security and how networks fail. Each one links to others, so start anywhere and follow the threads. New notes go out on <a class="tlink" href="/rss.xml">RSS</a>.</p>
  </section>

  <section style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 24px;">
    <div class="chips" role="group" aria-label="Filter by topic">
      {chips.map((chip, i) => (
        <button type="button" class:list={['chip', { on: i === 0 }]} data-topic={i === 0 ? '' : chip.label} aria-pressed={i === 0 ? 'true' : 'false'}>
          {chip.label} <span class="k" aria-hidden="true">{chip.count}</span>
        </button>
      ))}
    </div>
    <span id="notes-count" class="faint" style="font-size: 13px;" aria-live="polite" data-total={plural(posts.length)}>{plural(posts.length)}</span>
  </section>

  <section id="note-list" class="rows" style="padding-bottom: 64px;">
    {notes.map((note) => (
      <a class="note" href={note.href} data-note-id={note.id} data-topics={note.topics}>
        <span class="n" aria-hidden="true"><span class="node"></span></span>
        <span class="t">{note.title}</span>
        <time class="when" datetime={note.datetime}>{note.date}</time>
        <span class="d">{note.desc}</span>
        <span class="links">{note.meta}</span>
      </a>
    ))}
  </section>
</SiteLayout>

<script>
  // Topic chips filter the list. The topic lives in ?topic= so a filtered view can be shared.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-note-id]'));
  const count = document.querySelector<HTMLElement>('#notes-count')!;

  function applyTopic(topic: string) {
    const known = chips.some((chip) => chip.dataset.topic === topic);
    const active = known ? topic : '';
    chips.forEach((chip) => {
      const on = chip.dataset.topic === active;
      chip.classList.toggle('on', on);
      chip.setAttribute('aria-pressed', String(on));
    });
    let shown = 0;
    rows.forEach((row) => {
      row.hidden = Boolean(active) && !row.dataset.topics!.split('|').includes(active);
      if (!row.hidden) shown++;
    });
    count.textContent = active ? `${shown} of ${count.dataset.total}` : count.dataset.total!;
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    const topic = chip.dataset.topic!;
    const url = new URL(location.href);
    if (topic) url.searchParams.set('topic', topic);
    else url.searchParams.delete('topic');
    history.replaceState(null, '', url);
    applyTopic(topic);
  }));

  applyTopic(new URLSearchParams(location.search).get('topic') ?? '');
</script>

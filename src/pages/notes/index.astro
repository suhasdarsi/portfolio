---
import { getPublishedBlogEntriesByDate } from '../../utils/content';
import { formatDate } from '../../utils/date';

import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = await getPublishedBlogEntriesByDate();
---

<BlogLayout title="Notes — Suhas Darsi" description="Practical field notes on AI security, agent systems, and network risk.">
  <header class="page-header">
    <h1 class="page-heading">Notes</h1>
  </header>

  <!-- Searching happens in the top bar. Its "Browse or share this search" link lands here as ?q=,
       so the list filters itself and offers a way back to everything. -->
  <p id="notes-search-status" class="search-status" role="status" hidden>
    <span id="notes-search-summary"></span>
    <a href="/notes" id="notes-search-clear">Clear search</a>
  </p>

  <h2 class="section-label">All notes <span class="section-count">{posts.length}</span></h2>
  <ul class="rows note-list" id="note-list">
    {posts.map((post) => (
      <li class="note-item" data-note-id={post.id}>
        <a href={`/notes/${post.id}`} class="row note-link">
          <span class="note-body">
            <span class="row-title note-title">{post.data.title}</span>
            <span class="note-excerpt" hidden></span>
          </span>
          <time class="row-meta" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </a>
      </li>
    ))}
    {posts.length === 0 && <li>No notes found.</li>}
  </ul>
</BlogLayout>

<script>
  import { searchDocuments } from '../../utils/client-search';
  import { highlightText, searchExcerpt } from '../../utils/search-display';
  import { createSearchLoader } from '../../utils/search-loader';
  import type { SearchEntry } from '../../utils/search';

  const status = document.querySelector<HTMLElement>('#notes-search-status')!;
  const summary = document.querySelector<HTMLElement>('#notes-search-summary')!;
  const clear = document.querySelector<HTMLAnchorElement>('#notes-search-clear')!;
  const list = document.querySelector<HTMLElement>('#note-list')!;
  const articles = Array.from(list.querySelectorAll<HTMLElement>('[data-note-id]'));
  const originals = articles.map((article) => ({
    article,
    title: article.querySelector('.note-title')!.textContent!.trim(),
  }));
  const loadSearch = createSearchLoader<SearchEntry>();
  let version = 0;

  async function applySearch(query: string) {
    const current = ++version;
    if (!query.trim()) {
      originals.forEach(({ article, title }) => {
        article.hidden = false;
        article.querySelector('.note-title')!.textContent = title;
        article.querySelector<HTMLElement>('.note-excerpt')!.hidden = true;
        list.append(article);
      });
      status.hidden = true;
      return;
    }
    status.hidden = false;
    summary.textContent = 'Searching notes…';
    try {
      const documents = await loadSearch();
      if (current !== version) return;
      const results = searchDocuments(documents, query);
      articles.forEach((article) => { article.hidden = true; });
      results.forEach((result) => {
        const article = articles.find((item) => item.dataset.noteId === result.id);
        if (!article) return;
        article.hidden = false;
        highlightText(article.querySelector<HTMLElement>('.note-title')!, result.title, query);
        // While searching, a short excerpt shows where the match is.
        const excerpt = article.querySelector<HTMLElement>('.note-excerpt')!;
        highlightText(excerpt, searchExcerpt(result.body, query, result.description), query);
        excerpt.hidden = false;
        list.append(article);
      });
      summary.textContent = results.length
        ? `${results.length} ${results.length === 1 ? 'note matches' : 'notes match'} “${query}”`
        : `No notes match “${query}”`;
    } catch {
      if (current !== version) return;
      summary.textContent = 'Search is unavailable. Reload to retry.';
    }
  }

  clear.addEventListener('click', (event) => {
    event.preventDefault();
    history.pushState(null, '', '/notes');
    void applySearch('');
  });
  window.addEventListener('popstate', () => void applySearch(new URLSearchParams(location.search).get('q') ?? ''));
  void applySearch(new URLSearchParams(location.search).get('q') ?? '');
</script>

<style>
  .search-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: -1rem 0 2.5rem;
    color: var(--color-muted-foreground);
  }
  .search-status[hidden] { display: none; }
  .search-status a { color: var(--color-foreground); text-underline-offset: 3px; }
  .note-item[hidden] { display: none; }
  .note-body { display: grid; gap: 0.25rem; min-width: 0; }
  .note-title { text-wrap: balance; }
  .note-excerpt { color: var(--color-muted-foreground); font-size: var(--type-sm); line-height: 1.55; text-wrap: pretty; }
  .note-excerpt[hidden] { display: none; }
  @media (max-width: 520px) {
    .note-link { flex-direction: column-reverse; gap: 0.25rem; }
  }
</style>

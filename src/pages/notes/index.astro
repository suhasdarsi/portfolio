---
import { getPublishedBlogEntriesByDate } from '../../utils/content';
import { formatDate } from '../../utils/date';

import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = await getPublishedBlogEntriesByDate();
---

<BlogLayout title="AI Security Notes | Suhas Darsi" description="Practical field notes on AI security, agent systems, and network risk.">
  <div class="notes-header">
    <div class="notes-header-top">
      <div>
        <h1 class="notes-heading page-heading">AI security field notes</h1>
        <p class="notes-intro">Practical essays on how AI systems fail, how attacks propagate through connected agents, and how builders can contain the risk.</p>
      </div>
    </div>
  </div>

  <form class="notes-search" role="search" action="/notes">
    <label for="notes-query">Search notes</label>
    <div class="notes-search-controls">
      <input id="notes-query" name="q" type="search" placeholder="Search titles and full text" />
      <button type="submit">Search</button>
    </div>
    <p id="notes-search-status" role="status"></p>
  </form>
  <div class="note-list" id="note-list">
    {posts.map((post) => (
      <article class="note-item" data-note-id={post.id}>
        <a href={`/notes/${post.id}`} class="note-link">
          <div class="note-meta-top">
            {post.data.topics.length > 0 && (
              <div class="note-topics">
                {post.data.topics.map((topic) => (
                  <span class="topic-tag">{topic}</span>
                ))}
              </div>
            )}
          </div>
          <h2 class="note-title">
            {post.data.title}
          </h2>
          <p class="note-desc">
            {post.data.description}
          </p>
          <div class="note-meta">
            <div class="note-date">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </div>
          </div>
        </a>
      </article>
    ))}
    {posts.length === 0 && <p>No notes found.</p>}
  </div>
</BlogLayout>

<script>
  import { searchDocuments } from '../../utils/client-search';
  import { highlightText, searchExcerpt } from '../../utils/search-display';
  import type { SearchEntry } from '../../utils/search';

  const form = document.querySelector<HTMLFormElement>('.notes-search')!;
  const input = document.querySelector<HTMLInputElement>('#notes-query')!;
  const status = document.querySelector<HTMLElement>('#notes-search-status')!;
  const list = document.querySelector<HTMLElement>('#note-list')!;
  const articles = Array.from(list.querySelectorAll<HTMLElement>('[data-note-id]'));
  const originals = articles.map((article) => ({
    article,
    title: article.querySelector('.note-title')!.textContent!.trim(),
    description: article.querySelector('.note-desc')!.textContent!.trim(),
  }));
  let data: Promise<SearchEntry[]> | undefined;
  let version = 0;

  async function applySearch(query: string) {
    const current = ++version;
    input.value = query;
    if (!query.trim()) {
      originals.forEach(({ article, title, description }) => {
        article.hidden = false;
        article.querySelector('.note-title')!.textContent = title;
        article.querySelector('.note-desc')!.textContent = description;
        list.append(article);
      });
      status.textContent = '';
      return;
    }
    status.textContent = 'Searching notes…';
    try {
      data ??= fetch('/search.json').then((response) => {
        if (!response.ok) throw new Error('Search unavailable');
        return response.json();
      }).catch((error) => { data = undefined; throw error; });
      const documents = await data;
      if (current !== version) return;
      const results = searchDocuments(documents, query);
      articles.forEach((article) => { article.hidden = true; });
      results.forEach((result) => {
        const article = articles.find((item) => item.dataset.noteId === result.id);
        if (!article) return;
        article.hidden = false;
        highlightText(article.querySelector<HTMLElement>('.note-title')!, result.title, query);
        highlightText(article.querySelector<HTMLElement>('.note-desc')!, searchExcerpt(result.body, query, result.description), query);
        list.append(article);
      });
      status.textContent = results.length ? `${results.length} ${results.length === 1 ? 'note' : 'notes'} found` : 'No notes match. Try different words.';
    } catch {
      if (current !== version) return;
      status.textContent = 'Search is unavailable. Submit again to retry.';
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const url = new URL(window.location.href);
    const query = input.value.trim();
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    if (url.href !== window.location.href) history.pushState(null, '', url);
    void applySearch(query);
  });
  window.addEventListener('popstate', () => void applySearch(new URLSearchParams(location.search).get('q') ?? ''));
  void applySearch(new URLSearchParams(location.search).get('q') ?? '');
</script>

<style>
  .notes-search { margin-bottom: 2rem; }
  .notes-search label { display: block; margin-bottom: .5rem; }
  .notes-search-controls { display: flex; gap: .5rem; }
  .notes-search input { flex: 1; min-width: 0; padding: .65rem; border: 1px solid var(--color-subtle-border); border-radius: 4px; background: var(--color-background); color: var(--color-foreground); }
  .notes-search button { padding: .65rem 1rem; border: 1px solid var(--color-foreground); border-radius: 4px; background: var(--color-foreground); color: var(--color-background); cursor: pointer; }
  #notes-search-status { font-size: .875rem; }
  .note-item[hidden] { display: none; }

  .notes-header {
    margin-bottom: 3rem;
  }

  .notes-header-top {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .notes-heading {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.05;
  }

  .notes-intro {
    max-width: 38rem;
    margin: 0;
    color: var(--color-body-text);
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .note-list {
    display: flex;
    flex-direction: column;
  }

  .note-item {
    padding: 0;
    border: 0;
  }

  .note-item:last-child {
    padding-bottom: 0;
  }

  .note-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.875rem 1rem;
    margin: 0 -1rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s ease;
  }

  .note-link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .note-link:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  :global(html.dark) .note-link:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .note-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .note-topics {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .note-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0 0 0.35rem;
  }

  .note-desc {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    color: var(--color-body-text);
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .note-date {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-muted-foreground);
  }
</style>

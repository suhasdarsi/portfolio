---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { noteCover } from '../../notes/cover';
import { getNoteLinks, getNotes, noteHref, readingTime } from '../../notes/notes';
import { formatDate } from '../../site/format';
import NoteStage from '../../components/NoteStage.astro';

const posts = await getNotes();
const links = getNoteLinks(posts);
const plural = (n: number) => `${n} ${n === 1 ? 'note' : 'notes'}`;

const topics = new Map<string, number>();
for (const post of posts) {
  for (const topic of post.data.topics) topics.set(topic, (topics.get(topic) ?? 0) + 1);
}
const chips = [{ label: 'All', count: posts.length }, ...[...topics].map(([label, count]) => ({ label, count }))];

const notes = posts.map((post) => {
  const { linksTo, linkedFrom } = links.get(post.id)!;
  const linked = new Set([...linksTo, ...linkedFrom]).size;
  return {
    id: post.id,
    href: noteHref(post.id),
    title: post.data.title,
    desc: post.data.description,
    date: formatDate(post.data.pubDate, { year: true }),
    cover: noteCover(post.id, links.get(post.id)!),
    datetime: post.data.pubDate.toISOString(),
    topics: post.data.topics.join('|'),
    stage: post.data.stage,
    readingTime: readingTime(post),
    linked: linked > 0 ? `${linked} linked ${linked === 1 ? 'note' : 'notes'}` : '',
  };
});
---

<SiteLayout
  title="Notes on AI Security and Agent Systems — Suhas Darsi"
  description="Practical field notes on AI security, agent systems, and network risk."
  current="notes"
>
  <section class="page-head">
    <span class="g-count" aria-hidden="true">{posts.length}</span>
    <h1 class="title">Notes</h1>
    <p class="lede">A garden of notes on AI security and how networks fail. Each one links to others, so start anywhere and follow the threads. New notes go out on <a class="tlink" href="/rss.xml">RSS</a>.</p>
  </section>

  <section style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 24px;">
    <div class="chips" role="group" aria-label="Filter by topic">
      <span class="eyebrow" style="align-self: center; margin-right: 4px;">Topics</span>
      {chips.map((chip, i) => (
        <button type="button" class:list={['chip', { on: i === 0 }]} data-topic={i === 0 ? '' : chip.label} aria-pressed={i === 0 ? 'true' : 'false'}>
          {chip.label} <span class="k" aria-hidden="true">{chip.count}</span>
        </button>
      ))}
    </div>
    <span id="notes-count" class="faint" style="font-size: 15px;" aria-live="polite" data-total={plural(posts.length)}>{plural(posts.length)}</span>
  </section>

  <section id="note-list" class="g-index">
    {notes.map((note) => (
      <a class="g-card" href={note.href} data-note-id={note.id} data-topics={note.topics}>
        <span class="g-cover"><svg viewBox="0 0 320 220" aria-hidden="true" set:html={note.cover} /></span>
        <span class="g-title serif">{note.title}</span>
        <span class="g-desc">{note.desc}</span>
        <span class="g-meta"><NoteStage stage={note.stage} /><time datetime={note.datetime}>{note.date}</time><span>{note.readingTime}</span>{note.linked && <span>{note.linked}</span>}</span>
      </a>
    ))}
  </section>
</SiteLayout>

<script>
  // Topic chips filter the list. The topic lives in ?topic= so a filtered view can be shared.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-note-id]'));
  const count = document.querySelector<HTMLElement>('#notes-count')!;

  function applyTopic(topic: string) {
    const known = chips.some((chip) => chip.dataset.topic === topic);
    const active = known ? topic : '';
    chips.forEach((chip) => {
      const on = chip.dataset.topic === active;
      chip.classList.toggle('on', on);
      chip.setAttribute('aria-pressed', String(on));
    });
    let shown = 0;
    rows.forEach((row) => {
      row.hidden = Boolean(active) && !row.dataset.topics!.split('|').includes(active);
      if (!row.hidden) shown++;
    });
    count.textContent = active ? `${shown} of ${count.dataset.total}` : count.dataset.total!;
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    const topic = chip.dataset.topic!;
    const url = new URL(location.href);
    if (topic) url.searchParams.set('topic', topic);
    else url.searchParams.delete('topic');
    history.replaceState(null, '', url);
    applyTopic(topic);
  }));

  applyTopic(new URLSearchParams(location.search).get('topic') ?? '');
</script>

<style is:global>
  /* The garden index: every note as a card, three across on a wide screen. */
  .g-count { font-size: 15px; color: var(--accent-text); font-weight: 500; }
  .g-index { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 48px 32px; padding-bottom: 64px; }
</style>

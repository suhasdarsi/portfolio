---
import { render } from 'astro:content';
import { getPublishedBlogEntriesByDate } from '../../utils/content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import RevisionHistory from '../../components/RevisionHistory.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import CopyCode from '../../components/CopyCode.astro';
import { formatDateWithYear, getReadingTime } from '../../utils/date';

export async function getStaticPaths() {
	const posts = await getPublishedBlogEntriesByDate();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: { post, newer: posts[index - 1], older: posts[index + 1] },
	}));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const revisionDates = post.data.revisions.map((revision) => revision.date.valueOf());
const modifiedDates = [...revisionDates, ...(post.data.updatedDate ? [post.data.updatedDate.valueOf()] : [])];
const updatedDate = modifiedDates.length ? new Date(Math.max(...modifiedDates, post.data.pubDate.valueOf())) : undefined;
const readingTime = getReadingTime(post.body || '');

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suhasdarsi.com';
const canonicalUrl = `${siteUrl}/notes/${post.id}`;
const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(post.data.title);
const encodedBlueskyPost = encodeURIComponent(`${post.data.title} ${canonicalUrl}`);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
  "author": { "@type": "Person", "name": "Suhas Darsi" },
  "url": canonicalUrl
}).replace(/</g, '\\u003c');
---

<BlogLayout title={`${post.data.title} | Suhas Darsi`} description={post.data.description} ogType="article" ogImage={`${siteUrl}/og/${post.id}.png`}>
  <ReadingProgress />
  <CopyCode />
  <script type="application/ld+json" set:html={structuredData} />
  <article>
    <header class="article-header">
      <a href="/notes" class="back-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        All notes
      </a>
      <h1 class="article-title page-heading">{post.data.title}</h1>
      {post.data.description && <p class="article-standfirst">{post.data.description}</p>}
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDateWithYear(post.data.pubDate)}</time>
        {updatedDate && (
          <span>· Updated <time datetime={updatedDate.toISOString()}>{formatDateWithYear(updatedDate)}</time></span>
        )}
        {readingTime && <span>· {readingTime}</span>}
      </div>
    </header>

    <div class="prose-custom">
      <Content />
    </div>

    <RevisionHistory revisions={post.data.revisions} />

    <footer class="article-share" aria-label="Share this essay">
      <span class="share-label">Share</span>
      <a href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
      </a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"></path></svg>
      </a>
      <a href={`https://bsky.app/intent/compose?text=${encodedBlueskyPost}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Bluesky">
        <svg viewBox="0 0 600 530" fill="currentColor" aria-hidden="true"><path d="M135.72 44.03C202.216 93.951 273.74 195.17 300 249.49c26.262-54.316 97.782-155.54 164.28-205.46C512.26 8.009 590-19.862 590 68.825c0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.38-3.69-10.832-3.708-7.896-.017-2.936-1.193.516-3.707 7.896-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.45-163.25-81.433C20.15 217.613 9.997 86.535 9.997 68.825c0-88.687 77.742-60.816 125.72-24.795z"></path></svg>
      </a>
      <a href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`} aria-label="Share by email">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path></svg>
      </a>
    </footer>

    {(older || newer) && (
      <nav class="article-pager" aria-label="More notes">
        {older && (
          <a href={`/notes/${older.id}`} class="pager-link">
            <span class="pager-label">← Previous</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a href={`/notes/${newer.id}`} class="pager-link pager-next">
            <span class="pager-label">Next →</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BlogLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 1.5rem -0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-buttons);
    color: var(--color-muted-foreground);
    font-family: var(--font-sans);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-foreground);
    background: var(--color-muted);
  }

  .back-link svg { transition: transform 0.15s ease; }
  .back-link:hover svg { transform: translateX(-2px); }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .article-title { margin: 0 0 0.875rem; }
  .article-standfirst {
    margin: 0 0 1.25rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-body-text);
    text-wrap: pretty;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted-foreground);
  }

  .article-share {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
    font-family: var(--font-sans);
  }

  .share-label { font-weight: 500; }

  .article-share a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 16px visual icon, 44px hit area: padding expands, negative margin restores flow. */
    padding: 0.875rem;
    margin: -0.875rem;
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .article-share a:hover { color: var(--color-foreground); }
  .article-share svg { width: 1rem; height: 1rem; }

  .article-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .pager-link {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .pager-link:hover {
    border-color: var(--color-muted-foreground);
    background: color-mix(in srgb, var(--color-subtle) 60%, transparent);
  }

  .pager-next { grid-column: 2; text-align: right; }
  .pager-label { color: var(--color-muted-foreground); font-size: 0.875rem; }
  .pager-title { font-weight: 700; line-height: 1.35; text-wrap: balance; }

  @media (max-width: 520px) {
    .article-pager { grid-template-columns: 1fr; }
    .pager-next { grid-column: auto; }
  }
</style>

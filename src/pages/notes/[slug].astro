---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CopyCode from '../../components/CopyCode.astro';
import CopyLink from '../../components/CopyLink.astro';
import ReadingGuide from '../../components/ReadingGuide.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import RevisionHistory from '../../components/RevisionHistory.astro';
import { getNoteLinks, getPublishedBlogEntriesByDate, type BlogEntry } from '../../utils/content';
import { formatDate, formatDateWithYear, getReadingTime } from '../../utils/date';
import { stripDiagramSource } from '../../utils/diagrams.mjs';
import { PERSON_ID, breadcrumbs, type JsonLd } from '../../utils/structured-data';

export async function getStaticPaths() {
  const posts = await getPublishedBlogEntriesByDate();
  const links = getNoteLinks(posts);
  const byId = new Map(posts.map((post) => [post.id, post]));
  return posts.map((post, index) => {
    const { linksTo, linkedFrom } = links.get(post.id)!;
    return {
      params: { slug: post.id },
      props: {
        post,
        newer: posts[index - 1],
        older: posts[index + 1],
        linksTo: linksTo.map((id) => byId.get(id)!),
        // Oldest first, so the backlinks read in the order the notes were written.
        linkedFrom: linkedFrom.map((id) => byId.get(id)!).reverse(),
      },
    };
  });
}

interface Props {
  post: BlogEntry;
  newer?: BlogEntry;
  older?: BlogEntry;
  linksTo: BlogEntry[];
  linkedFrom: BlogEntry[];
}

const { post, newer, older, linksTo, linkedFrom } = Astro.props;
const { Content, headings } = await render(post);
const href = (note: BlogEntry) => `/notes/${note.id}`;
const modifiedDates = [
  ...post.data.revisions.map((revision) => revision.date.valueOf()),
  ...(post.data.updatedDate ? [post.data.updatedDate.valueOf()] : []),
];
const updatedDate = modifiedDates.length
  ? new Date(Math.max(...modifiedDates, post.data.pubDate.valueOf()))
  : undefined;
const readingTime = getReadingTime(stripDiagramSource(post.body || ''));
const pubDay = post.data.pubDate.toISOString().slice(0, 10);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suhasdarsi.com';
const canonicalUrl = `${siteUrl}/notes/${post.id}`;
const previewImage = `${siteUrl}/og/${post.id}.png`;
const encodedUrl = encodeURIComponent(canonicalUrl);
const share = {
  x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  bluesky: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${post.data.title} ${canonicalUrl}`)}`,
};
const isMe = post.data.author === 'Suhas Darsi';
const structuredData: JsonLd[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    // The site owner links to the shared Person entity; guest authors get an inline one.
    author: isMe ? { '@id': PERSON_ID } : { '@type': 'Person', name: post.data.author },
    image: previewImage,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    url: canonicalUrl,
  },
  breadcrumbs([
    { name: 'Home', url: siteUrl },
    { name: 'Notes', url: `${siteUrl}/notes` },
    { name: post.data.title, url: canonicalUrl },
  ]),
];
// Keep the full title under the ~65 character display limit: drop the site suffix on long note titles.
const fullTitle = `${post.data.title} — Suhas Darsi`;
const pageTitle = fullTitle.length <= 65 ? fullTitle : post.data.title;
---

<SiteLayout
  title={pageTitle}
  description={post.data.description}
  author={post.data.author}
  ogType="article"
  ogImage={previewImage}
  current="notes"
  pageType="WebPage"
  jsonLd={structuredData}
>
  <div style="padding-top: 32px; padding-bottom: 32px;">
    <a class="tool" href="/notes">← Notes</a>
  </div>

  <div class="layout" style="padding-bottom: 64px;">
    <article class="article" data-reader>
      <header style="display: grid; gap: 12px;">
        <span class="eyebrow">{post.data.topics[0] && <>{post.data.topics[0]} · </>}<time datetime={pubDay}>{formatDateWithYear(post.data.pubDate)}</time>{readingTime && <> · {readingTime}</>}</span>
        <h1 class="title">{post.data.title}</h1>
        {post.data.description && <p class="lede">{post.data.description}</p>}
        {updatedDate && (
          <span class="faint" style="font-size: 13px;">Updated <time datetime={updatedDate.toISOString()}>{formatDateWithYear(updatedDate)}</time></span>
        )}
        <div class="share" aria-label="Share this note" role="group">
          <CopyLink url={canonicalUrl} />
          <a class="tool" href={share.x} target="_blank" rel="noopener noreferrer">Share on X</a>
          <a class="tool" href={share.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">LinkedIn</a>
          <a class="tool" href={share.bluesky} target="_blank" rel="noopener noreferrer" aria-label="Share on Bluesky">Bluesky</a>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <RevisionHistory revisions={post.data.revisions} />

      {linkedFrom.length > 0 && (
        <section style="display: grid; gap: 12px; border-top: 1px solid var(--line); padding-top: 24px;">
          <h2 style="font-size: 16px; font-weight: 500;">Linked from</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
            {linkedFrom.map((note) => (
              <a class="linkcard" href={href(note)}><span class="k">{formatDate(note.data.pubDate)}</span><span class="t">{note.data.title}</span></a>
            ))}
          </div>
        </section>
      )}

      {(older || newer) && (
        <nav class="pager" aria-label="More notes">
          {older ? <a class="linkcard" href={href(older)}><span class="k">← Older</span><span class="t">{older.data.title}</span></a> : <span></span>}
          {newer && <a class="linkcard" href={href(newer)} style="text-align: right;"><span class="k">Newer →</span><span class="t">{newer.data.title}</span></a>}
        </nav>
      )}

      {isMe ? (
        <a href="/about" class="byline">
          <span aria-hidden="true" class="avatar">SD</span>
          <span style="display: grid;"><span style="font-weight: 500;">Suhas Darsi</span><span class="muted" style="font-size: 16px;">Co-founder of SuperAlign. Writes about how AI systems fail.</span></span>
        </a>
      ) : (
        <p class="byline"><span style="font-weight: 500;">{post.data.author}</span></p>
      )}
    </article>

    <ReadingGuide headings={headings} linksTo={linksTo.map((note) => ({ href: href(note), title: note.data.title }))} />
  </div>

  <Fragment slot="after">
    <ReadingProgress />
    <CopyCode />
  </Fragment>
</SiteLayout>

<style is:global>
  /* Markdown emits <strong>; give it the weight site.css gives .prose b. */
  .prose strong { color: var(--ink); font-weight: 600; }
  .layout { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .article { flex: 999 1 560px; min-width: 0; display: grid; gap: 32px; }
  .aside { flex: 1 1 200px; max-width: 230px; display: grid; gap: 24px; align-content: start; padding-top: 8px; }
  .guide { display: grid; gap: 8px; font-size: 13px; }
  .guide a { color: var(--muted); border-left: 1px solid var(--line); padding-left: 12px; }
  .guide a:hover { color: var(--ink); border-left-color: var(--ink); }
  .tool { display: inline-flex; align-items: center; gap: 8px; font: inherit; font-size: 13px; color: var(--muted); background: none; border: 0; padding: 8px 0; cursor: pointer; }
  .tool:hover, .tool.on { color: var(--ink); }
  .share { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 4px 24px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 8px; }
  .linkcard { display: grid; gap: 4px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .linkcard:hover { border-color: var(--line-strong); }
  .linkcard .k { font-family: Geist, sans-serif; font-size: 13px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; }
  .linkcard .t { font-size: 16px; line-height: 1.35; color: var(--ink); }
  .linkcard:hover .t { color: var(--accent-text); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .byline { display: flex; align-items: center; gap: 12px; padding: 16px 0; border-top: 1px solid var(--line); }
  .avatar { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; background: var(--soft); font-size: 13px; font-weight: 600; }
  @media (max-width: 760px) { .aside { max-width: none; } .pager { grid-template-columns: minmax(0, 1fr); } }
  @media print { .share, .pager, .aside { display: none; } }
</style>

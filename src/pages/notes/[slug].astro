---
import { render } from 'astro:content';
import { getPublishedBlogEntriesByDate } from '../../utils/content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import RevisionHistory from '../../components/RevisionHistory.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import CopyCode from '../../components/CopyCode.astro';
import ReadingGuide from '../../components/ReadingGuide.astro';
import CopyLink from '../../components/CopyLink.astro';
import TextSize from '../../components/TextSize.astro';
import { formatDateWithYear, getReadingTime } from '../../utils/date';
import { stripDiagramSource } from '../../utils/diagrams.mjs';

export async function getStaticPaths() {
  const posts = await getPublishedBlogEntriesByDate();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const revisionDates = post.data.revisions.map((revision) => revision.date.valueOf());
const modifiedDates = [
  ...revisionDates,
  ...(post.data.updatedDate ? [post.data.updatedDate.valueOf()] : []),
];
const updatedDate = modifiedDates.length
  ? new Date(Math.max(...modifiedDates, post.data.pubDate.valueOf()))
  : undefined;
const readingTime = getReadingTime(stripDiagramSource(post.body || ''));

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suhasdarsi.com';
const canonicalUrl = `${siteUrl}/notes/${post.id}`;
const previewImage = `${siteUrl}/og/${post.id}.png`;
const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(post.data.title);
const encodedBlueskyPost = encodeURIComponent(`${post.data.title} ${canonicalUrl}`);
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: post.data.author,
    ...(post.data.author === 'Suhas Darsi' ? { url: `${siteUrl}/about` } : {}),
  },
  image: previewImage,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  url: canonicalUrl,
}).replace(/</g, '\\u003c');
---

<BlogLayout
  title={`${post.data.title} — Suhas Darsi`}
  description={post.data.description}
  author={post.data.author}
  ogType="article"
  ogImage={previewImage}
>
  <ReadingProgress />
  <CopyCode />
  <script type="application/ld+json" set:html={structuredData} />
  <article class="reading-note" data-reader>
    <div class="note-rail rail-end">
      <div class="rail-inner">
        <a href="/notes" class="back-link">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          All notes
        </a>
        <TextSize />
        <footer class="article-share" aria-label="Share this essay">
          <CopyLink url={canonicalUrl} />
          <div class="tool-group">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
              class="tool-btn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
              class="tool-btn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"></path>
              </svg>
            </a>
            <a
              href={`https://bsky.app/intent/compose?text=${encodedBlueskyPost}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on Bluesky"
              class="tool-btn"
            >
              <svg viewBox="0 0 600 530" fill="currentColor" aria-hidden="true">
                <path d="M135.72 44.03C202.216 93.951 273.74 195.17 300 249.49c26.262-54.316 97.782-155.54 164.28-205.46C512.26 8.009 590-19.862 590 68.825c0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.38-3.69-10.832-3.708-7.896-.017-2.936-1.193.516-3.707 7.896-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.45-163.25-81.433C20.15 217.613 9.997 86.535 9.997 68.825c0-88.687 77.742-60.816 125.72-24.795z"></path>
              </svg>
            </a>
            <a
              href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
              aria-label="Share by email"
              class="tool-btn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path>
              </svg>
            </a>
          </div>
        </footer>

        {(older || newer) && (
          <nav class="article-pager" aria-label="More notes">
            {older && (
              <a href={`/notes/${older.id}`} class="pager-link">
                <span class="pager-label">← Previous</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a href={`/notes/${newer.id}`} class="pager-link pager-next">
                <span class="pager-label">Next →</span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>

    <header class="article-header">
      <h1 class="article-title page-heading">{post.data.title}</h1>
      {post.data.description && <p class="article-standfirst">{post.data.description}</p>}
      <p class="article-author">
        By{' '}
        {post.data.author === 'Suhas Darsi' ? (
          <a href="/about">{post.data.author}</a>
        ) : (
          post.data.author
        )}
      </p>
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDateWithYear(post.data.pubDate)}
        </time>
        {updatedDate && (
          <span>
            · Updated{' '}
            <time datetime={updatedDate.toISOString()}>{formatDateWithYear(updatedDate)}</time>
          </span>
        )}
        {readingTime && <span>· {readingTime}</span>}
      </div>
    </header>

    <div class="note-rail rail-start">
      <div class="rail-inner">
        <ReadingGuide headings={headings} />
      </div>
    </div>
    <div class="prose-custom">
      <Content />
    </div>

    <RevisionHistory revisions={post.data.revisions} />
  </article>
</BlogLayout>

<style>
  .reading-note {
    --reading-size: clamp(1.0625rem, 1rem + 0.25vw, 1.125rem);
  }
  .reading-note[data-text-size='large'] {
    --reading-size: clamp(1.1875rem, 1.1rem + 0.4vw, 1.25rem);
  }

  /* Narrow screens: one column. The rails dissolve so their pieces fall back into reading order:
     back link and text size above the note, outline under the header, share and pager at the end. */
  .reading-note {
    display: flex;
    flex-direction: column;
  }
  .note-rail,
  .rail-inner {
    display: contents;
  }
  .back-link,
  .reading-note :global(.size-toggle) {
    align-self: flex-start;
  }
  .back-link {
    order: 0;
  }
  .article-header {
    order: 1;
  }
  .reading-note :global(.size-toggle) {
    order: 2;
  }
  .reading-note :global(.note-outline) {
    order: 3;
    margin-bottom: 2.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-custom {
    order: 4;
  }
  .reading-note :global(.revision-history) {
    order: 5;
  }
  .article-share {
    order: 6;
  }
  .article-pager {
    order: 7;
  }

  .article-header {
    margin-bottom: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 0;
  }
  .article-author {
    margin: 0 0 0.375rem;
    color: var(--color-body-text);
    font-size: var(--type-sm);
  }
  .article-author a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
  }
  .article-meta {
    font-size: var(--type-sm);
    gap: 0.25rem 0.5rem;
  }
  .reading-note :global(.prose-custom) {
    font-size: var(--reading-size);
    line-height: 1.85;
    letter-spacing: 0;
  }
  .reading-note :global(.prose-custom h2) {
    font-size: 1.25em;
    line-height: 1.4;
    margin-top: 2.75em;
    margin-bottom: 0.85em;
    letter-spacing: -0.02em;
  }
  .reading-note :global(.prose-custom h3) {
    font-size: 1.0625em;
    line-height: 1.5;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }
  .reading-note :global(.prose-custom p) {
    margin-bottom: 1.4em;
  }
  .reading-note :global(.prose-custom li) {
    margin-bottom: 0.65em;
  }
  .reading-note :global(.prose-custom li p) {
    margin-bottom: 0.5em;
  }
  .reading-note :global(.prose-custom a) {
    text-decoration-color: var(--color-muted-foreground);
    text-underline-offset: 4px;
  }
  .reading-note :global(.prose-custom blockquote) {
    border-color: var(--color-border-strong);
    color: var(--color-body-text);
  }
  .reading-note :global(.prose-custom :is(h2, h3):target) {
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.3em;
  }
  @media print {
    .reading-note :global(.reading-guide),
    .article-share,
    .article-pager {
      display: none;
    }
    .reading-note :global(.prose-custom) {
      font-size: 11pt;
      line-height: 1.6;
    }
  }

  .article-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    color: var(--color-muted-foreground);
    font-family: var(--font-sans);
  }

  .share-label {
    font-size: var(--type-sm);
  }
  .article-share svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .article-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pager-link {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-buttons);
    color: var(--color-foreground);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .pager-link:hover {
    background: var(--color-muted);
  }

  .pager-next {
    grid-column: 2;
    text-align: right;
  }
  .pager-label {
    color: var(--color-muted-foreground);
    font-size: var(--type-sm);
  }
  .pager-title {
    font-weight: 500;
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (max-width: 520px) {
    .article-pager {
      grid-template-columns: 1fr;
    }
    .pager-next {
      grid-column: auto;
    }
  }

  /* Wide screens: like Tempo's Focus Mode, the note keeps the white panel to itself. The outline sits
     on the grey desk to the left, and every control (back, text size, share, pager) to the right. */
  @media (min-width: 70rem) {
    .reading-note {
      --rail-width: 11rem;
      --rail-gap: calc(var(--panel-pad) + 1.5rem);
      position: relative;
    }
    .note-rail {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      width: var(--rail-width);
    }
    .rail-start {
      right: calc(100% + var(--rail-gap));
    }
    .rail-end {
      left: calc(100% + var(--rail-gap));
    }
    .rail-inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      position: sticky;
      top: 2rem;
    }
    .back-link {
      margin: 0 0 1rem;
      align-self: flex-start;
    }
    .reading-note :global(.size-toggle) {
      align-self: stretch;
    }
    .reading-note :global(.note-outline) {
      margin: 0;
      padding: 0;
      border: 0;
    }
    .article-share {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      margin-top: 0;
    }
    .article-share :global(.copy-link button) {
      width: 100%;
      text-align: left;
    }
    .article-share .tool-group {
      display: flex;
    }
    .article-share .tool-btn {
      flex: 1;
      padding: 0;
    }
    .article-pager {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }
    .pager-next {
      grid-column: auto;
      text-align: left;
    }
    .pager-link {
      padding: 0.625rem 0.75rem;
    }
    .pager-title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      font-size: var(--type-sm);
    }
  }
</style>

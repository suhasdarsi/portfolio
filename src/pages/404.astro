---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found — Suhas Darsi"
  description="The page you were looking for could not be found. Browse the notes or search to find what you need."
>
  <section class="page-head" style="padding-block: 96px 64px; gap: 24px; max-width: 620px;">
    <span class="eyebrow">404</span>
    <h1 class="title">This page wandered off.</h1>
    <p class="lede">The link may be old, or the note may have moved. Try one of these, or search the notes below.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
      <a class="btn dark" href="/">Go home</a>
      <a class="btn" href="/notes">Browse notes</a>
    </div>
    <div style="display: grid; gap: 8px; padding-top: 16px;">
      <div class="field-wrap">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <label for="error-search-input" class="vh">Search all notes</label>
        <input id="error-search-input" class="field" type="search" placeholder="Try “network risk”" autocomplete="off" />
      </div>
      <div class="rows" id="error-search-results"></div>
      <p class="muted" id="error-search-status" role="status" style="font-size: 16px;"></p>
    </div>
  </section>
</SiteLayout>

<script>
  import { createSearchLoader, liveSearch, searchDocuments } from '../search/client';

  const input = document.getElementById('error-search-input') as HTMLInputElement;
  const results = document.getElementById('error-search-results')!;
  const status = document.getElementById('error-search-status')!;
  const loadSearch = createSearchLoader();

  liveSearch(input, async (query, isCurrent) => {
    results.replaceChildren();
    status.textContent = '';
    if (!query) return;

    try {
      const notes = await loadSearch();
      if (!isCurrent()) return;
      const hits = searchDocuments(notes, query).slice(0, 5);
      status.textContent = hits.length ? '' : 'No notes match that yet.';
      results.replaceChildren(...hits.map((hit) => {
        const link = document.createElement('a');
        link.className = 'mrow error-search-result';
        link.href = hit.href;
        const title = document.createElement('span');
        title.className = 'serif';
        title.textContent = hit.title;
        const date = document.createElement('span');
        date.className = 'l';
        date.textContent = hit.meta;
        link.append(title, date);
        return link;
      }));
    } catch {
      if (isCurrent()) status.textContent = 'Search is unavailable. Type again to retry.';
    }
  });
</script>

<style is:global>
  #error-search-status:empty { display: none; }
</style>

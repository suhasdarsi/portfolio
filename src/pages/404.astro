---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublishedBlogEntriesByDate } from '../utils/content';
import { formatDate } from '../utils/date';

// Note dates for the result rows; titles and bodies come from /search.json.
const dates = Object.fromEntries((await getPublishedBlogEntriesByDate()).map((post) => [`/notes/${post.id}`, formatDate(post.data.pubDate)]));
---

<SiteLayout title="Page not found — Suhas Darsi" description="Page not found — Suhas Darsi">
  <section class="page-head" style="padding-block: 96px 64px; gap: 24px; max-width: 620px;">
    <span class="eyebrow">404</span>
    <h1 class="title">This page wandered off.</h1>
    <p class="lede">The link may be old, or the note may have moved. Try one of these, or search the notes below.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
      <a class="btn dark" href="/">Go home</a>
      <a class="btn" href="/notes">Browse notes</a>
    </div>
    <div style="display: grid; gap: 8px; padding-top: 16px;">
      <div class="field-wrap">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <label for="error-search-input" class="vh">Search all notes</label>
        <input id="error-search-input" class="field" type="search" placeholder="Try “network risk”" autocomplete="off" />
      </div>
      <div class="rows" id="error-search-results" data-dates={JSON.stringify(dates)}></div>
      <p class="muted" id="error-search-status" role="status" style="font-size: 16px;"></p>
    </div>
  </section>
</SiteLayout>

<script>
  import { searchDocuments } from '../utils/client-search';
  import { createSearchLoader, debounce } from '../utils/search-loader';

  type SearchPost = { href: string; title: string; description?: string; body?: string };

  const input = document.getElementById('error-search-input') as HTMLInputElement | null;
  const results = document.getElementById('error-search-results');
  const status = document.getElementById('error-search-status');
  const dates: Record<string, string> = JSON.parse(results?.dataset.dates ?? '{}');
  const loadSearch = createSearchLoader<SearchPost>();
  let requestId = 0;

  const update = debounce(async () => {
    const currentRequest = ++requestId;
    const query = input?.value.trim() ?? '';
    results?.replaceChildren();
    if (status) status.textContent = '';
    if (!query) return;

    try {
      const posts = await loadSearch();
      if (currentRequest !== requestId) return;
      const hits = searchDocuments(posts, query).slice(0, 5);
      if (status) status.textContent = hits.length ? '' : 'No notes match that yet.';
      results?.replaceChildren(...hits.map((hit) => {
        const link = document.createElement('a');
        link.className = 'mrow error-search-result';
        link.href = hit.href;
        const title = document.createElement('span');
        title.className = 'serif';
        title.textContent = hit.title;
        const date = document.createElement('span');
        date.className = 'l';
        date.textContent = dates[hit.href] ?? '';
        link.append(title, date);
        return link;
      }));
    } catch {
      if (currentRequest !== requestId) return;
      if (status) status.textContent = 'Search is unavailable. Type again to retry.';
    }
  });

  input?.addEventListener('input', () => void update());
</script>

<style is:global>
  #error-search-status:empty { display: none; }
</style>

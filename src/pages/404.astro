---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="404 — Page Not Found | Suhas Darsi" description="Page not found — Suhas Darsi">
  <header class="error-header">
    <p class="eyebrow">Error 404</p>
    <h1 class="page-heading">This page doesn’t exist.</h1>
    <p class="page-intro">It might have been moved or deleted, or the URL may have a typo.</p>
  </header>
  <div class="error-actions">
    <a href="/" class="button">Go home</a>
    <a href="/notes" class="button-quiet">Browse notes</a>
  </div>
  <section class="error-search-wrap">
    <h2 class="section-label">Or search the notes</h2>
    <div class="error-search-control">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input type="search" id="error-search-input" class="field" placeholder="Try “network risk”" aria-label="Search all notes" autocomplete="off" />
    </div>
    <p id="error-search-status" role="status"></p>
    <div class="rows error-search-results" id="error-search-results"></div>
  </section>
</BlogLayout>

<script>
  import { searchDocuments } from '../utils/client-search';
  import { createSearchLoader, debounce } from '../utils/search-loader';

  const input = document.getElementById('error-search-input') as HTMLInputElement;
  const results = document.getElementById('error-search-results');
  const status = document.getElementById('error-search-status');
  let requestId = 0;

  type SearchPost = {
    href: string;
    title: string;
    description?: string;
    body?: string;
  };

  const loadSearch = createSearchLoader<SearchPost>();

  const handleSearchInput = debounce(async () => {
    const currentRequest = ++requestId;
    const query = input.value.trim();
    results?.replaceChildren();
    if (status) status.textContent = query ? 'Loading notes…' : '';
    if (!query) return;

    try {
      const searchPosts = await loadSearch();
      if (currentRequest !== requestId) return;
      const hits = searchDocuments(searchPosts, query).slice(0, 5);
      if (status) status.textContent = hits.length ? '' : 'No notes match. Try different words.';
      results?.replaceChildren(...hits.map((hit) => {
        const link = document.createElement('a');
        link.href = hit.href;
        link.className = 'row error-search-result';
        link.textContent = hit.title;
        return link;
      }));
    } catch {
      if (currentRequest !== requestId) return;
      if (status) status.textContent = 'Search is unavailable. Type again to retry.';
    }
  });

  input?.addEventListener('input', () => handleSearchInput());
</script>

<style>
  .error-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2rem 0 3.5rem; }
  .error-actions .button-quiet { margin-left: -0.25rem; }
  .error-search-control { position: relative; display: flex; align-items: center; margin-top: 0.5rem; }
  .search-icon { position: absolute; left: 0.875rem; color: var(--color-muted-foreground); pointer-events: none; }
  .error-search-control .field { padding-left: 2.5rem; }
  #error-search-status { margin-top: 0.75rem; color: var(--color-muted-foreground); }
  #error-search-status:empty { display: none; }
  .error-search-results { margin-top: 0.75rem; }
</style>

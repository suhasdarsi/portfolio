---
import ToolshedLayout from '../../layouts/ToolshedLayout.astro';
import { categoryTags } from '../../toolshed/catalog';
import { toolCategories } from '../../toolshed/categories';
import { categoryHref, getCategoryGuide, getTools, inCategory } from '../../toolshed/tools';

const tools = await getTools();
const categories = await Promise.all(toolCategories.map(async (category) => {
  const kinds = categoryTags[category][0].tags.map((tag) => tag.name);
  return {
    category,
    href: categoryHref(category),
    summary: (await getCategoryGuide(category))?.data.summary,
    count: inCategory(tools, category).length,
    kinds: kinds.slice(0, 3).join(' · ') + (kinds.length > 3 ? ` · +${kinds.length - 3}` : ''),
  };
}));
---

<ToolshedLayout search title="Toolshed — independent security tools research" description="Free, independent research on the security tools market: what each category does, how its tools fit together, and how the market is shaped. Nobody can pay to be listed.">
  <section class="page-head" style="max-width: 720px;">
    <h1 class="title">Toolshed</h1>
    <p class="lede">Independent research on the security tools market. What each category does, how the tools fit together, and how the market is shaped. Free to read, and nobody can pay to be listed.</p>
    <p class="faint" style="font-size: 13px;">{tools.length} tools · {toolCategories.length} categories · <a class="tlink" href="/toolshed/about">How it works</a></p>
  </section>

  <section style="display: grid; gap: 16px; padding-bottom: 64px;">
    <h2 class="eyebrow">Categories</h2>
    <div class="cgrid">
      {categories.map((c) => (
        <a class="ccard ts-category-card" href={c.href}>
          <div class="top"><span class="nm">{c.category}</span><span class="ct">{c.count}</span></div>
          {c.summary && <p class="sm">{c.summary}</p>}
          <p class="tg">{c.kinds}</p>
        </a>
      ))}
    </div>
  </section>
</ToolshedLayout>

<style is:global>
  .cgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ccard { display: grid; gap: 8px; align-content: start; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); min-width: 0; }
  .ccard:hover { border-color: var(--line-strong); }
  .ccard .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .ccard .nm { font-family: "Geist Serif", serif; font-size: 16px; font-weight: 600; line-height: 1.4; }
  .ccard:hover .nm { color: var(--accent-text); }
  .ccard .ct { font-family: Geist, sans-serif; font-size: 13px; color: var(--faint); }
  .ccard .sm { font-size: 16px; line-height: 1.5; color: var(--muted); }
  .ccard .tg { font-size: 13px; color: var(--faint); line-height: 1.5; }
  @media (max-width: 1000px) { .cgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .cgrid { grid-template-columns: minmax(0, 1fr); } }
</style>

---
import ToolshedLayout from '../../layouts/ToolshedLayout.astro';
import { categoryTags } from '../../data/security-tools';
import { toolCategories, toolSlug } from '../../data/toolshed';
import { getCategoryGuide, getTools } from '../../utils/content';

const tools = await getTools();
const categories = await Promise.all(toolCategories.map(async (category) => ({
  category,
  href: `/toolshed/${toolSlug(category)}`,
  summary: (await getCategoryGuide(category))?.data.summary,
  count: tools.filter((tool) => tool.categories.includes(category)).length,
  kinds: categoryTags[category][0].tags.map((tag) => tag.name),
})));
---

<ToolshedLayout title="Toolshed — independent security tools research" description="Free, independent research on the security tools market: what each category does, how its tools fit together, and how the market is shaped. Nobody can pay to be listed.">
  <header class="ts-hero">
    <h1 class="page-heading">Toolshed</h1>
    <p class="ts-lede">Independent research on the security tools market. What each category does, how the tools fit together, and how the market is shaped. Free to read, and nobody can pay to be listed.</p>
    <p class="ts-stats">{tools.length} tools · {toolCategories.length} categories · <a href="/toolshed/about">How it works</a></p>
  </header>

  <section aria-labelledby="categories-title" id="categories">
    <h2 class="ts-section-title" id="categories-title">Categories</h2>
    <ul class="ts-category-grid">
      {categories.map((c) => (
        <li>
          <a href={c.href} class="ts-category-card">
            <span class="title"><span>{c.category}</span><span class="count">{c.count}</span></span>
            {c.summary && <span class="summary">{c.summary}</span>}
            <span class="kinds">{c.kinds.slice(0, 3).join(' · ')}{c.kinds.length > 3 && ` · +${c.kinds.length - 3}`}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</ToolshedLayout>

<style>
  .ts-hero { max-width: 46rem; margin-bottom: 3rem; }
  .ts-lede { margin: 0.75rem 0 0; font-size: var(--type-md); line-height: 1.55; color: var(--color-body-text); text-wrap: pretty; }
  .ts-stats { margin: 1rem 0 0; font-size: var(--type-sm); color: var(--color-muted-foreground); font-variant-numeric: tabular-nums; }
  .ts-stats a { color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px; }

  .ts-category-grid {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.75rem;
  }

  .ts-category-card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .ts-category-card:hover { border-color: var(--color-border-strong); background: var(--color-muted); }
  .title { display: flex; justify-content: space-between; gap: 1rem; font-weight: 500; letter-spacing: -0.01em; }
  .count { color: var(--color-muted-foreground); font-weight: 400; font-variant-numeric: tabular-nums; }
  .summary { font-size: var(--type-sm); line-height: 1.55; color: var(--color-body-text); }
  .kinds { margin-top: 0.25rem; font-size: 0.75rem; line-height: 1.5; color: var(--color-muted-foreground); }
</style>

---
import ToolshedLayout from '../../layouts/ToolshedLayout.astro';
import { toolCategories } from '../../data/toolshed';
import { githubIssueLink } from '../../utils/toolshed-request';

// The form goes live once the Turnstile sitekey is set at build time; until then it points to GitHub.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const fallback = githubIssueLink('suhasdarsi/portfolio');
---

<ToolshedLayout
  banner={false}
  title="Suggest a tool — Toolshed"
  description="Suggest a security tool for Toolshed, or a correction to one that's listed. Listing is free and decided on merit."
  turnstile={Boolean(sitekey)}
>
  <div style="max-width: 760px; padding-bottom: 64px; display: grid; gap: 32px;">
    <div class="page-head" style="padding-bottom: 0;">
      <p class="faint" style="font-size: 13px;"><a href="/toolshed">Toolshed</a> / Suggest a tool</p>
      <h1 class="title">Suggest a tool or a correction</h1>
      <p class="lede">Free, and decided on merit. Nobody can pay to be listed, and suggesting a tool doesn’t guarantee it gets added.</p>
    </div>
    <div class="points">
      <div class="point"><b>Vendors are welcome</b><span>Just say you work for or with them. It won’t count against the tool.</span></div>
      <div class="point"><b>Requests are public</b><span>Each one becomes a GitHub issue anyone can read, so don’t include anything private.</span></div>
      <div class="point"><b>What gets listed</b><span>Security tools that are publicly available, with a working website and a clear job.</span></div>
    </div>

    {sitekey ? (
      <form id="suggest-form" class="box form" novalidate data-sitekey={sitekey}>
        <fieldset class="kind">
          <legend>What would you like to do?</legend>
          <label><input type="radio" name="kind" value="add" checked /> Add a tool</label>
          <label><input type="radio" name="kind" value="correct" /> Correct a listed tool</label>
        </fieldset>

        <label>Tool name<input class="field plain" name="name" required maxlength="80" autocomplete="off" /></label>
        <label>Website<input class="field plain" name="url" type="url" required maxlength="300" placeholder="https://" autocomplete="off" /></label>

        <fieldset>
          <legend>Categories <span class="faint">(optional)</span></legend>
          <div class="categories">
            {toolCategories.map((category) => (
              <label class="check"><input type="checkbox" name="categories" value={category} /> {category}</label>
            ))}
          </div>
        </fieldset>

        <label>
          <span id="details-label">What does it do?</span>
          <textarea class="field plain" name="details" required minlength="10" maxlength="1500" rows="5"></textarea>
        </label>

        <fieldset class="kind">
          <legend>Do you work for or with the vendor?</legend>
          <label><input type="radio" name="affiliated" value="no" checked /> No</label>
          <label><input type="radio" name="affiliated" value="yes" /> Yes</label>
        </fieldset>
        <label id="relationship" hidden>
          How are you connected?
          <input class="field plain" name="relationship" maxlength="160" placeholder="For example: I work there, or we're a partner" />
        </label>

        <!-- Hidden from people; bots fill it in. -->
        <label class="trap" aria-hidden="true">
          Website (leave empty)
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>

        <div id="turnstile"></div>
        <button type="submit" class="btn dark" style="justify-self: start;">Send request</button>
        <p id="suggest-status" class="status" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <div class="box">
        <p style="font-size: 16px;">The form isn’t open yet. For now, open a request on GitHub. It comes pre-filled with the questions I need answered.</p>
        <p class="faint" style="font-size: 13px; line-height: 1.7;">Website · Categories · Do you work for or with the vendor? · What it does, or what should change</p>
        <a class="btn dark" style="justify-self: start;" href={fallback} target="_blank" rel="noopener noreferrer">Open a request on GitHub ↗<span class="vh"> (opens in a new tab)</span></a>
      </div>
    )}
  </div>
</ToolshedLayout>

{sitekey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>
)}

<script>
  import { validateToolRequest } from '../../utils/toolshed-request';

  type Turnstile = {
    render(el: string, options: Record<string, unknown>): string;
    reset(id: string): void;
    getResponse(id: string): string | undefined;
  };
  const form = document.querySelector<HTMLFormElement>('#suggest-form');
  const status = document.getElementById('suggest-status');
  const relationship = document.getElementById('relationship');
  const detailsLabel = document.getElementById('details-label');
  let widgetId: string | undefined;

  // Render the widget explicitly so it can be reset after each attempt; tokens are single-use.
  function renderWidget() {
    const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
    if (!form || widgetId !== undefined) return;
    if (!turnstile) {
      setTimeout(renderWidget, 200);
      return;
    }
    widgetId = turnstile.render('#turnstile', {
      sitekey: form.dataset.sitekey,
      action: 'toolshed_request',
    });
  }

  if (form) {
    renderWidget();
    form.addEventListener('change', () => {
      const data = new FormData(form);
      if (relationship) relationship.hidden = data.get('affiliated') !== 'yes';
      if (detailsLabel)
        detailsLabel.textContent =
          data.get('kind') === 'correct' ? 'What should change?' : 'What does it do?';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      const data = new FormData(form);
      const say = (message: string) => {
        if (status) status.textContent = message;
      };
      let request;
      try {
        request = validateToolRequest({
          kind: data.get('kind'),
          name: data.get('name'),
          url: data.get('url'),
          categories: data.getAll('categories'),
          details: data.get('details'),
          affiliated: data.get('affiliated') === 'yes',
          relationship: data.get('relationship') ?? '',
        });
      } catch (error) {
        say(error instanceof Error ? error.message : 'Check the form and try again.');
        return;
      }
      const token = widgetId !== undefined ? turnstile?.getResponse(widgetId) : undefined;
      if (!token) {
        say('Please complete the check above the button.');
        return;
      }

      const button = form.querySelector('button');
      button?.setAttribute('disabled', '');
      say('Sending…');
      try {
        const response = await fetch('/api/toolshed/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ request, token, website: data.get('website') }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok)
          throw new Error(result.error ?? 'Something went wrong. Please try again.');
        form.reset();
        if (detailsLabel) detailsLabel.textContent = 'What does it do?';
        if (relationship) relationship.hidden = true;
        if (status) {
          status.textContent = 'Thanks, your request is in. ';
          if (result.url) {
            const link = Object.assign(document.createElement('a'), {
              href: result.url,
              textContent: 'Follow it on GitHub',
              target: '_blank',
              rel: 'noopener noreferrer',
            });
            status.append(link, '.');
          }
        }
      } catch (error) {
        say(error instanceof Error ? error.message : 'Something went wrong. Please try again.');
      } finally {
        button?.removeAttribute('disabled');
        if (widgetId !== undefined) turnstile?.reset(widgetId);
      }
    });
  }
</script>

<style>
  .points { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .point { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 8px 24px; padding-block: 16px; border-bottom: 1px solid var(--line); font-size: 16px; }
  .point b { font-weight: 500; }
  .point span { color: var(--muted); line-height: 1.55; }
  .box { display: grid; gap: 12px; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .form { gap: 20px; }
  .form > label, #relationship { display: grid; gap: 8px; font-size: 13px; color: var(--ink); }
  fieldset { margin: 0; padding: 0; border: 0; display: grid; gap: 8px; }
  legend { margin-bottom: 8px; font-size: 13px; color: var(--ink); }
  .kind { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .kind legend { width: 100%; }
  .kind label, .check { display: inline-flex; gap: 8px; align-items: center; font-size: 13px; color: var(--body); }
  .categories { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 4px 16px; }
  textarea.field { height: auto; padding-block: 8px; resize: vertical; }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .status { min-height: 1.5em; font-size: 13px; color: var(--body); }
  .status :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) { .point { grid-template-columns: minmax(0, 1fr); } }
</style>

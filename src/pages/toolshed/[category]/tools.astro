---
import ToolshedLayout from '../../../layouts/ToolshedLayout.astro';
import CategoryShell from '../../../components/toolshed/CategoryShell.astro';
import ToolCard from '../../../components/toolshed/ToolCard.astro';
import { categoryTags } from '../../../data/security-tools';
import { toolCategories, toolSlug } from '../../../data/toolshed';
import { getTools } from '../../../utils/content';

export async function getStaticPaths() {
  return toolCategories.map((category) => ({ params: { category: toolSlug(category) }, props: { category } }));
}

const { category } = Astro.props;
const tools = await getTools();
const inCategory = tools.filter((tool) => tool.categories.includes(category));
const groups = categoryTags[category].map((group) => ({
  ...group,
  tags: group.tags.map((tag) => ({ ...tag, count: inCategory.filter((tool) => tool.tags.includes(tag.name)).length })),
}));
---

<ToolshedLayout title={`${category} tools — Toolshed`} description={`Every ${category.toLowerCase()} tool in Toolshed, tagged by the jobs it does.`}>
  <CategoryShell tools={tools} category={category} tab="tools" title={`${category} tools`}>
    <div class="filters">
      {groups.map((group) => (
        <div class="fgroup" role="group" aria-label={group.name}>
          <span class="eyebrow">{group.name}</span>
          <div class="chips">
            {group.tags.map((tag) => (
              <button type="button" class="chip" data-tag={tag.name} aria-pressed="false" title={tag.summary}>{tag.name} <span class="k">{tag.count}</span></button>
            ))}
          </div>
        </div>
      ))}
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
        <span class="faint" id="tool-count" style="font-size: 13px;" role="status" aria-live="polite">{inCategory.length} of {inCategory.length} tools</span>
        <button type="button" class="chip" id="tool-clear" hidden>Clear filters</button>
      </div>
    </div>

    <div id="tool-list" style="border-top: 1px solid var(--line);">
      {inCategory.map((tool) => <ToolCard tool={tool} category={category} />)}
      <p id="tool-empty" class="muted" style="padding-block: 24px;" hidden>No tool carries all of those tags.</p>
    </div>
  </CategoryShell>
</ToolshedLayout>

<script>
  // Tags narrow the list: a tool must carry every selected tag. ?tag= (repeatable) preselects, for links from Overview.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-tool]'));
  const count = document.getElementById('tool-count');
  const empty = document.getElementById('tool-empty');
  const clear = document.getElementById('tool-clear');
  const allowed = new Set(buttons.map((button) => button.dataset.tag));
  const selected = new Set(new URLSearchParams(location.search).getAll('tag').filter((tag) => allowed.has(tag)));

  function apply() {
    let visible = 0;
    for (const item of items) {
      const tags: string[] = JSON.parse(item.dataset.tags ?? '[]');
      const matches = [...selected].every((tag) => tags.includes(tag));
      item.hidden = !matches;
      if (matches) visible++;
      item.querySelectorAll<HTMLElement>('[data-tag-name]').forEach((tag) => tag.classList.toggle('on', selected.has(tag.dataset.tagName ?? '')));
    }
    for (const button of buttons) {
      const on = selected.has(button.dataset.tag ?? '');
      button.setAttribute('aria-pressed', String(on));
      button.classList.toggle('on', on);
    }
    if (count) count.textContent = `${visible} of ${items.length} tools`;
    if (empty) empty.hidden = visible > 0;
    if (clear) clear.hidden = selected.size === 0;
    const url = new URL(location.href);
    url.searchParams.delete('tag');
    for (const tag of selected) url.searchParams.append('tag', tag);
    history.replaceState(null, '', url);
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? '';
      if (selected.has(tag)) selected.delete(tag);
      else selected.add(tag);
      apply();
    });
  }
  clear?.addEventListener('click', () => { selected.clear(); apply(); });
  apply();
</script>

<style>
  .filters { display: grid; gap: 12px; }
  .fgroup { display: grid; gap: 8px; }
</style>

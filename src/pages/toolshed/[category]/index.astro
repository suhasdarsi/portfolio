---
import { getCollection, render } from 'astro:content';
import ToolshedLayout from '../../../layouts/ToolshedLayout.astro';
import CategoryShell from '../../../components/toolshed/CategoryShell.astro';
import TagMatrix from '../../../components/toolshed/TagMatrix.astro';
import { categoryTags, type TagGroup } from '../../../data/security-tools';
import { toolCategories, toolSlug, type ToolCategory } from '../../../data/toolshed';
import { getCategoryGuide, getTools, isPublished } from '../../../utils/content';

export async function getStaticPaths() {
  return toolCategories.map((category) => ({ params: { category: toolSlug(category) }, props: { category } }));
}

// A note of mine that explains the category, shown under the related categories.
const background: Partial<Record<ToolCategory, string>> = {
  'AI security': 'why-ai-security-is-fundamentally-different',
};

const { category } = Astro.props;
const tools = await getTools();
const guide = await getCategoryGuide(category);
const Content = guide ? (await render(guide)).Content : undefined;
const base = `/toolshed/${toolSlug(category)}`;
const groups = categoryTags[category];
const counts = new Map(groups.flatMap((group) => group.tags.map((tag) => [tag.name, tools.filter((tool) => tool.tags.includes(tag.name)).length] as const)));
const tagHref = (tag: string) => `${base}/tools?tag=${encodeURIComponent(tag)}`;
const hasAxes = (group: TagGroup): group is TagGroup & { axes: NonNullable<TagGroup['axes']> } => Boolean(group.axes);

// Categories that share tools with this one, most shared first.
const shared = new Map<ToolCategory, number>();
for (const tool of tools.filter((t) => t.categories.includes(category))) {
  for (const other of tool.categories) if (other !== category) shared.set(other, (shared.get(other) ?? 0) + 1);
}
const related = [...shared].sort((a, b) => b[1] - a[1] || toolCategories.indexOf(a[0]) - toolCategories.indexOf(b[0])).map(([other]) => other);
const note = background[category] ? (await getCollection('blog')).find((post) => post.id === background[category] && isPublished(post.data)) : undefined;
---

<ToolshedLayout title={`${category} — Toolshed`} description={guide?.data.summary ?? `Security tools for ${category.toLowerCase()}.`}>
  <CategoryShell tools={tools} category={category} tab="overview">
    {guide && <p class="lede" slot="head">{guide.data.summary}</p>}

    {groups.filter(hasAxes).map((group) => (
      <section style="display: grid; gap: 12px;">
        <h2 class="eyebrow">{group.name}</h2>
        <TagMatrix group={group} counts={counts} href={tagHref} />
      </section>
    ))}

    {groups.filter((group) => !group.axes).map((group) => (
      <section style="display: grid; gap: 8px;">
        <h2 class="eyebrow">{group.name}</h2>
        <div class="caps">
          {group.tags.map((tag) => (
            <a class="cap" href={tagHref(tag.name)}><span class="nm">{tag.name}</span><span class="ct">{counts.get(tag.name)}</span><span class="sm">{tag.summary}</span></a>
          ))}
        </div>
      </section>
    ))}

    {Content && (
      <section class="prose" style="max-width: 68ch;">
        <Content />
      </section>
    )}

    {(related.length > 0 || note) && (
      <section style="display: grid; gap: 12px; border-top: 1px solid var(--line); padding-top: 24px;">
        {related.length > 0 && <>
          <h2 class="eyebrow">Related categories</h2>
          <div class="chips">
            {related.map((other) => <a class="chip" href={`/toolshed/${toolSlug(other)}/tools`}>{other}</a>)}
          </div>
        </>}
        {note && <p class="muted" style="font-size: 16px;">Background reading: <a class="tlink" href={`/notes/${note.id}`}>{note.data.title}</a>, in my notes.</p>}
      </section>
    )}
  </CategoryShell>
</ToolshedLayout>

<style>
  .caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .cap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; padding-block: 12px; border-bottom: 1px solid var(--line); }
  .cap .nm { font-weight: 500; font-size: 16px; }
  .cap:hover .nm { color: var(--accent-text); }
  .cap .ct { font-family: Geist, sans-serif; font-size: 13px; color: var(--faint); }
  .cap .sm { grid-column: 1 / -1; font-size: 13px; color: var(--muted); line-height: 1.5; }
  @media (max-width: 760px) { .caps { grid-template-columns: minmax(0, 1fr); } }
</style>

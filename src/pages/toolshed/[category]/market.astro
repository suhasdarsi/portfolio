---
import { render } from 'astro:content';
import ToolshedLayout from '../../../layouts/ToolshedLayout.astro';
import CategoryShell from '../../../components/toolshed/CategoryShell.astro';
import { categoryTags } from '../../../toolshed/catalog';
import { categoryHref, categoryPaths, getMarketGuide, getTools, inCategory, tagsIn, toolLink } from '../../../toolshed/tools';
import { formatDate } from '../../../site/format';

export const getStaticPaths = categoryPaths;

const { category } = Astro.props;
const tools = await getTools();
const guide = await getMarketGuide(category);
const Content = guide ? (await render(guide)).Content : undefined;
const groups = categoryTags[category];
const columns = groups.flatMap((group) => group.tags.map((tag) => tag.name));
// Jobs are the tags outside a grid group (a grid says who an agent is, not what a tool does).
const jobs = new Set(groups.filter((group) => !group.axes).flatMap((group) => group.tags.map((tag) => tag.name)));

// Tools that do more than one job here, or that reach into other categories. Most tags first.
const multi = inCategory(tools, category)
  .map((tool) => ({ tool, link: toolLink(tool), tags: new Set(tagsIn(tool, category)), also: tool.categories.filter((other) => other !== category) }))
  .filter(({ tags, also }) => [...tags].filter((tag) => jobs.has(tag)).length > 1 || also.length > 0)
  .sort((a, b) => b.tags.size - a.tags.size || a.tool.name.localeCompare(b.tool.name));
---

<ToolshedLayout title={`${category} market guide — Toolshed`} description={guide?.data.summary ?? `How the ${category.toLowerCase()} security market is shaped.`}>
  <CategoryShell tools={tools} category={category} tab="market" title={`${category} market guide`}>
    {guide && <p class="faint" style="font-size: 13px;" slot="head">As of <time datetime={guide.data.asOf.toISOString()}>{formatDate(guide.data.asOf, { year: true })}</time></p>}

    {Content && (
      <section class="prose" style="max-width: 68ch;">
        <Content />
      </section>
    )}

    {multi.length > 0 && (
      <section style="display: grid; gap: 12px;" aria-labelledby="overlap-title">
        <div style="display: grid; gap: 8px;">
          <h2 class="sec-h" id="overlap-title">Tools that do more than one job</h2>
          <p class="muted" style="font-size: 16px;">Each dot is a tag the tool carries. Based on what vendors offer, not on my testing.</p>
        </div>
        <div class="table-box" tabindex="0" role="region" aria-label="Tags by tool">
          <table class="matrix">
            <thead>
              {groups.length > 1 && (
                <tr class="grp"><th></th>{groups.map((group) => <th scope="colgroup" colspan={group.tags.length}>{group.name}</th>)}<th></th></tr>
              )}
              <tr>
                <th scope="col">Tool</th>
                {columns.map((column) => <th scope="col"><span class="colh">{column}</span></th>)}
                <th scope="col" style="text-align: left;">Also in</th>
              </tr>
            </thead>
            <tbody>
              {multi.map(({ tool, link, tags, also }) => (
                <tr>
                  <td><a href={link.href} {...link.attrs}>{tool.name}{link.external && <span class="vh"> (opens in a new tab)</span>}</a></td>
                  {columns.map((column) => (
                    <td>{tags.has(column) ? <span class="dot"><span class="vh">Yes</span></span> : <span class="nodot"><span class="vh">No</span></span>}</td>
                  ))}
                  <td class="al">{also.map((other, i) => <>{i > 0 && ', '}<a href={categoryHref(other, 'tools')}>{other}</a></>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </CategoryShell>
</ToolshedLayout>

<style>
  .matrix .grp th { font-family: Geist, sans-serif; font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: var(--faint); border-bottom: 0; padding-bottom: 8px; }
  .colh { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 184px; text-align: left; font-size: 13px; }
  .matrix tbody tr:hover { background: var(--soft); }
  .matrix td.al { font-size: 13px; color: var(--faint); text-align: left; white-space: nowrap; }
  .matrix td a { display: inline-block; padding-block: 4px; }
  .matrix a:hover { color: var(--accent-text); }
  .table-box:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>

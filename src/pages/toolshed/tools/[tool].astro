---
import { render } from 'astro:content';
import ToolshedLayout from '../../../layouts/ToolshedLayout.astro';
import Sidebar from '../../../components/toolshed/Sidebar.astro';
import Rating from '../../../components/toolshed/Rating.astro';
import { categoryHref, getTools, hasReview, tagHref } from '../../../toolshed/tools';
import { formatDate, hostname } from '../../../site/format';

export async function getStaticPaths() {
  const tools = (await getTools()).filter(hasReview);
  return tools.map((tool) => ({ params: { tool: tool.id }, props: { tool, review: tool.review } }));
}

const { tool, review } = Astro.props;
const tools = await getTools();
const { Content } = await render(review);
const { rating, verdict, tried, updated, pricing, openSource, platforms, pros, cons } = review.data;
const host = hostname(tool.url);
const facts = [
  { label: 'Pricing', value: pricing },
  { label: 'Open source', value: openSource === undefined ? undefined : openSource ? 'Yes' : 'No' },
  { label: 'Platforms', value: platforms.join(', ') },
].filter((fact) => fact.value);
---

<ToolshedLayout title={`${tool.name} review — Toolshed`} description={verdict ?? `My notes on ${tool.name}.`}>
  <div class="ts-shell">
    <Sidebar tools={tools} />
    <article class="ts-main" style="max-width: 760px;">
      <div style="display: grid; gap: 12px;">
        <p class="faint" style="font-size: 13px;"><a href="/toolshed">Toolshed</a> / <a href="/toolshed/tools">All tools</a> / {tool.name}</p>
        <h1 class="title">{tool.name}{tool.affiliated && <span class="emp">My employer</span>}</h1>
        {verdict && <p class="lede">{verdict}</p>}
        <p class="faint meta" style="font-size: 13px;">
          {rating && <Rating rating={rating} />}
          {tried && <span>Tried <time datetime={tried.toISOString()}>{formatDate(tried, { year: true })}</time></span>}
          {updated && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated, { year: true })}</time></span>}
        </p>
      </div>

      <dl class="facts">
        <div class="fact"><dt>Tags</dt><dd class="chips">{tool.tags.map((tag) => <a class="chip" href={tagHref(tag)}>{tag}</a>)}</dd></div>
        <div class="fact"><dt>Categories</dt><dd>{tool.categories.map((category, i) => <>{i > 0 && ', '}<a class="tlink" href={categoryHref(category)}>{category}</a></>)}</dd></div>
        {facts.map((fact) => <div class="fact"><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        <div class="fact"><dt>Website</dt><dd><a class="tlink" href={tool.url} target="_blank" rel="noopener noreferrer">{host} ↗<span class="vh"> (opens in a new tab)</span></a></dd></div>
      </dl>

      {(pros.length > 0 || cons.length > 0) && (
        <div class="pros-cons">
          {pros.length > 0 && <section><h2 class="eyebrow">What works</h2><ul>{pros.map((pro) => <li>{pro}</li>)}</ul></section>}
          {cons.length > 0 && <section><h2 class="eyebrow">What doesn’t</h2><ul>{cons.map((con) => <li>{con}</li>)}</ul></section>}
        </div>
      )}

      <section class="prose"><Content /></section>
    </article>
  </div>
</ToolshedLayout>

<style>
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .facts { margin: 0; border-top: 1px solid var(--line); }
  .fact { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 8px 24px; padding-block: 12px; border-bottom: 1px solid var(--line); font-size: 16px; }
  .fact dt { color: var(--muted); }
  .fact dd { margin: 0; overflow-wrap: anywhere; }
  .pros-cons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .pros-cons section { display: grid; gap: 8px; align-content: start; }
  .pros-cons ul { padding-left: 16px; display: grid; gap: 8px; color: var(--body); line-height: 1.6; }
  @media (max-width: 640px) { .fact, .pros-cons { grid-template-columns: minmax(0, 1fr); } }
</style>

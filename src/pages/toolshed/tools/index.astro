---
import ToolshedLayout from '../../../layouts/ToolshedLayout.astro';
import Sidebar from '../../../components/toolshed/Sidebar.astro';
import ToolRow from '../../../components/toolshed/ToolRow.astro';
import { getTools } from '../../../utils/content';

const tools = await getTools();
// The first page shows before the script runs; the script owns the list from then on.
const PAGE = 60;
const left = tools.length - Math.min(PAGE, tools.length);
---

<ToolshedLayout title="All tools — Toolshed" description="Every security tool in Toolshed, searchable by name, tag, category or site.">
  <div class="ts-shell">
    <Sidebar tools={tools} current="all" />
    <div class="ts-main">
      <div style="display: grid; gap: 12px;">
        <p class="faint" style="font-size: 13px;"><a href="/toolshed">Toolshed</a> / All tools</p>
        <h1 class="title">All tools</h1>
      </div>
      <form class="field-wrap" role="search" id="tool-filter">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <label for="tool-search" class="vh">Find a tool</label>
        <input id="tool-search" class="field" type="search" placeholder="Search by name, category or site, e.g. mcp" autocomplete="off" aria-controls="tool-list" />
      </form>
      <div>
        <p class="faint" id="tool-count" style="font-size: 13px; padding-bottom: 8px;" role="status" aria-live="polite">{tools.length} {tools.length === 1 ? 'tool' : 'tools'}</p>
        <div id="tool-list" style="border-top: 1px solid var(--line);">
          {tools.map((tool, i) => <ToolRow tool={tool} hidden={i >= PAGE} />)}
        </div>
        <p id="tool-empty" class="muted" style="padding-block: 24px;" hidden>No tools match “<span id="tool-query"></span>”. <a class="tlink" href="/toolshed/suggest">Suggest one</a>.</p>
        <button type="button" id="tool-more" class="btn" style="margin-top: 16px;" hidden={left <= 0}>Show {Math.min(PAGE, left)} more of {left}</button>
      </div>
    </div>
  </div>
</ToolshedLayout>

<script>
  // Live search over name, site, categories and tags, shown 60 at a time. The header search lands here as ?q=.
  const PAGE = 60;
  const input = document.querySelector<HTMLInputElement>('#tool-search');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-tool]'));
  const count = document.getElementById('tool-count');
  const empty = document.getElementById('tool-empty');
  const query = document.getElementById('tool-query');
  const more = document.getElementById('tool-more');
  let limit = PAGE;

  function render() {
    const q = input?.value.trim().toLowerCase() ?? '';
    const matches = items.filter((item) => (item.dataset.search ?? '').includes(q));
    for (const item of items) item.hidden = true;
    matches.slice(0, limit).forEach((item) => { item.hidden = false; });
    const left = matches.length - Math.min(limit, matches.length);
    if (count) count.textContent = `${matches.length} ${matches.length === 1 ? 'tool' : 'tools'}`;
    if (query) query.textContent = input?.value.trim() ?? '';
    if (empty) empty.hidden = matches.length > 0;
    if (more) {
      more.hidden = left <= 0;
      more.textContent = `Show ${Math.min(PAGE, left)} more of ${left}`;
    }
  }

  const initial = new URLSearchParams(location.search).get('q');
  if (input && initial) input.value = initial;
  input?.addEventListener('input', () => { limit = PAGE; render(); });
  more?.addEventListener('click', () => { limit += PAGE; render(); });
  document.getElementById('tool-filter')?.addEventListener('submit', (event) => event.preventDefault());
  render();
</script>


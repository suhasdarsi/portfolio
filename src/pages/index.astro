---
import BlogLayout from '../layouts/BlogLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AppMark from '../components/AppMark.astro';
import { homeLinkGroups, primaryCta } from '../data/site-navigation';
import { getPublishedBlogEntriesByDate } from '../utils/content';
import { formatDate } from '../utils/date';

const recentNotes = (await getPublishedBlogEntriesByDate()).slice(0, 3);
const epigraph = 'Every network has a hub. Every hub is a way in.';
// Meta rows under the name, read like the sender lines on a Tempo message: value left, muted label right.
const profile = [
  { value: 'Co-founder, SuperAlign', label: 'Now' },
  { value: 'Founder, Aztlan', label: 'Before' },
  { value: 'Masters in AI, IIIT Hyderabad', label: 'Studied' },
];
---

<BlogLayout title="Suhas Darsi" description="Notes, micro-apps, and ways to connect with Suhas Darsi.">
  <header class="card-head">
    <h1 class="page-heading">Suhas Darsi</h1>
    <SocialLinks />
  </header>

  <dl class="card-meta">
    {profile.map((row) => (
      <div><dd>{row.value}</dd><dt>{row.label}</dt></div>
    ))}
  </dl>

  <div class="card-body">
    <p>
      Co-founder of <a href="https://superalign.ai" target="_blank" rel="noopener noreferrer" class="link-underline">SuperAlign</a>.
      I write about how AI systems fail and build small tools along the way.
    </p>
    <p class="card-note">
      <span class="sr-only">{epigraph}</span>
      <span class="typed" aria-hidden="true" data-text={epigraph}>{epigraph}</span><span class="caret" aria-hidden="true"></span>
    </p>
    <a href={primaryCta.href} target="_blank" rel="noopener noreferrer" class="button home-cta-mobile">{primaryCta.label}</a>
  </div>

  <div class="home-sections">
    {recentNotes.length > 0 && (
      <nav class="page-section" aria-label="Recent notes">
        <h2 class="section-label">Recent notes</h2>
        <ul class="rows">
          {recentNotes.map((post) => (
            <li>
              <a href={`/notes/${post.id}`} class="row row-stack">
                <span class="row-title">{post.data.title}</span>
                <span class="row-meta">{formatDate(post.data.pubDate)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/notes" class="home-more">All notes <span class="row-arrow" aria-hidden="true">→</span></a>
      </nav>
    )}

    {homeLinkGroups.map((group) => (
      <nav class="page-section" aria-label={group.label}>
        <h2 class="section-label">{group.label}</h2>
        {group.description && <p class="home-group-description">{group.description}</p>}
        <ul class:list={['rows', { 'app-cards': group.links.some((link) => 'mark' in link) }]}>
          {group.links.map((link) => 'mark' in link ? (
            <li>
              <a href={link.href} class="app-card">
                <span class="app-card-mark"><AppMark mark={link.mark} size="1.5rem" /></span>
                <span class="app-card-title"><span class="app-card-name">{link.label}</span><span class="row-arrow" aria-hidden="true">→</span></span>
                <span class="app-card-meta">{link.meta}</span>
              </a>
            </li>
          ) : (
            <li>
              <a href={link.href} class="row row-stack">
                <span class="row-title">{link.label}</span>
                <span class="row-meta">{link.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <p class="home-footnote">
      Follow new notes via <a href="/rss.xml" class="link-underline">RSS</a>.
    </p>
  </div>
</BlogLayout>

<script>
  // Type the note line once it scrolls into view. The full text is in the HTML
  // and in a screen-reader copy, so nothing depends on this running.
  const typed = document.querySelector<HTMLElement>('.card-note .typed');
  if (typed && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const text = typed.dataset.text ?? '';
    typed.textContent = '';
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      let i = 0;
      const type = () => {
        typed.textContent = text.slice(0, ++i);
        if (i < text.length) setTimeout(type, 42);
      };
      setTimeout(type, 400);
    });
    observer.observe(typed);
  }
</script>

<style>
  /* Title left, small outlined actions right, as on a Tempo message. */
  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .card-meta {
    margin: 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .card-meta div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3125rem 0;
  }
  .card-meta dd { margin: 0; color: var(--color-foreground); }
  .card-meta dt { flex-shrink: 0; color: var(--color-muted-foreground); }

  .card-body { padding: 2rem 0 4rem; }
  .card-body p { margin: 0 0 1rem; color: var(--color-body-text); line-height: 1.65; text-wrap: pretty; }
  .card-body a:not(.button) { color: var(--color-foreground); }

  /* The note types itself out, with Tempo's blue compose caret at the end. */
  .card-note { font-style: italic; }
  .card-body .card-note { color: var(--color-muted-foreground); }
  .caret {
    display: inline-block;
    width: 1px;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--color-accent);
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink { 50% { opacity: 0; } }

  /* On phones the toolbar drops its Say hello, so it appears here instead. */
  .home-cta-mobile { display: none; margin-top: 0.5rem; }
  @media (max-width: 520px) {
    .home-cta-mobile { display: inline-flex; }
  }

  .home-group-description { margin: -0.25rem 0 0.75rem; color: var(--color-muted-foreground); }
  .home-more {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: 0.75rem;
    color: var(--color-muted-foreground);
    font-size: var(--type-sm);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .home-more:hover { color: var(--color-foreground); }
  .home-more:hover .row-arrow { transform: translateX(3px); }

  /* Micro-apps are outlined panels: hairline box, grey wash on hover, no lift. */
  .app-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.625rem; }
  .app-card {
    display: grid;
    gap: 0.125rem;
    height: 100%;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-buttons);
    background: var(--color-subtle);
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .app-card:hover { background: var(--color-muted); }
  .app-card-mark {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-muted-foreground);
  }
  .app-card-title { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; font-weight: 500; }
  .app-card-title .row-arrow { color: var(--color-muted-foreground); }
  .app-card:hover .row-arrow { color: var(--color-foreground); transform: translateX(3px); }
  .app-card-meta { color: var(--color-muted-foreground); font-size: var(--type-sm); }
  .home-footnote { margin: 0; color: var(--color-muted-foreground); font-size: var(--type-sm); }
  .home-footnote a { color: var(--color-foreground); }
</style>

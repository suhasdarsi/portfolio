---
import { getPublishedBlogEntriesByDate } from '../utils/content';
import { formatDate } from '../utils/date';
import BlogLayout from '../layouts/BlogLayout.astro';

const notes = await getPublishedBlogEntriesByDate();
const recentNotes = notes.slice(0, 3);

const currently = [
  { label: 'Founder', name: 'SuperAlign AI', url: 'https://superalign.ai' },
  { label: 'Chair at AI Alignment Chapter', name: 'RIMAS Singapore', url: 'https://www.rimas.org.sg/' },
  { label: 'Guest Lecturer', name: 'SUSS', url: 'https://www.suss.edu.sg/' },
];

const previously = [
  { label: 'Founder', name: 'Aztlan', url: 'https://www.linkedin.com/company/aztlan/' },
  { label: 'Masters in AI', name: 'IIIT Hyderabad', url: 'https://www.iiit.ac.in/' },
  { label: 'Bachelors', name: 'IIIT Hyderabad', url: 'https://www.iiit.ac.in/' },
];
---

<BlogLayout title="Suhas Darsi" description="Suhas Darsi — long-form notes about AI security, agent systems, and network risk.">
  <header class="home-header">
    <h1 class="home-name page-heading">Suhas Darsi</h1>
    <p class="home-tagline">Founder · Researcher · Writer</p>
    <div class="home-socials">
      <a href="https://www.linkedin.com/in/suhasdarsi/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://x.com/suhas_darsi" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X (Twitter)">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a href="mailto:suhas@superalign.ai" class="social-icon social-email" aria-label="Copy email address: suhas@superalign.ai" data-copy-email="suhas@superalign.ai">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span class="social-tip" role="status" aria-live="polite">Copy email</span>
      </a>
    </div>
  </header>

  <p class="home-bio"><b>I'm a co-founder at <a href="https://superalign.ai" class="bio-link link-underline">SuperAlign</a></b>, where we help security teams see, understand, and control AI adoption across their organizations.</p>
  <p class="home-bio">My background is in Computer Vision research at IIIT Hyderabad. These days I focus on how AI systems fail, how risk propagates through connected agents, and the controls required to deploy them safely.</p>
  <p class="home-bio">This site is where I publish long-form notes on AI security, agent architecture, and the network dynamics behind systemic failures.</p>

  <div class="home-link-row">
    <nav class="home-index" aria-label="Site">
      <a href="/notes" class="home-index-link">Notes</a>
      <a href="/uses" class="home-index-link">Uses</a>
    </nav>

    <div class="cta-row">
      <a href="https://booking.akiflow.com/suhas--e823" target="_blank" rel="noopener noreferrer" class="action-link">
        Say Hello
      </a>

      <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="action-link">
        Subscribe via RSS
      </a>
    </div>
  </div>

  <section class="timeline-section">
    <h2 class="section-heading">Currently</h2>
    <ul class="timeline-list">
      {currently.map((item) => (
        <li>
          <a href={item.url} class="timeline-row" target="_blank" rel="noopener noreferrer">
            <span class="timeline-name">{item.name}</span>
            <span class="timeline-role">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="section-heading">Previously</h2>
    <ul class="timeline-list">
      {previously.map((item) => (
        <li>
          <a href={item.url} class="timeline-row" target="_blank" rel="noopener noreferrer">
            <span class="timeline-name">{item.name}</span>
            <span class="timeline-role">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="recent-section">
    <h2 class="section-heading">Latest notes</h2>
    <div class="recent-posts">
      {recentNotes.map((note) => (
        <a href={`/notes/${note.id}`} class="recent-item">
          <span class="recent-title">{note.data.title}</span>
          <span class="recent-meta">
            <span>{note.data.topics[0] ?? 'Note'}</span>
            <span aria-hidden="true">·</span>
            <time datetime={note.data.pubDate.toISOString()} class="tabular-nums">{formatDate(note.data.pubDate)}</time>
          </span>
        </a>
      ))}
    </div>
    <a href="/notes" class="view-all-link">
      Explore all notes
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>
</BlogLayout>

<script>
  const copyEmail = document.querySelector('[data-copy-email]');

  copyEmail?.addEventListener('click', async (event) => {
    event.preventDefault();
    const email = copyEmail.getAttribute('data-copy-email');
    if (!email) return;

    const tip = copyEmail.querySelector('.social-tip');
    const original = tip?.textContent;

    try {
      await navigator.clipboard.writeText(email);
      if (tip) tip.textContent = 'copied ✓';
    } catch {
      window.location.href = `mailto:${email}`;
      return;
    }

    if (tip) {
      setTimeout(() => {
        tip.textContent = original || '';
      }, 1600);
    }
  });
</script>

<style>
  .home-header {
    margin-bottom: 2rem;
  }

  .home-name {
    margin: 0 0 0.25rem;
    font-size: var(--text-title);
  }

  .home-tagline {
    margin: 0 0 0.75rem;
    color: var(--color-muted-foreground);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 450;
  }

  .home-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 0;
    color: var(--color-muted-foreground);
    transition: color 0.15s ease;
  }

  .social-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .social-icon:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .social-icon:hover {
    color: var(--color-foreground);
  }

  .social-tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.35rem 0.6rem;
    border-radius: 0.375rem;
    background: #2b2825;
    color: #f7f0e7;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .social-email:hover .social-tip,
  .social-email:focus-visible .social-tip {
    opacity: 1;
  }

  html.dark .social-icon:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .home-bio {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-body-text);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 40rem;
    text-wrap: pretty;
  }

  .home-bio b {
    color: var(--color-foreground);
    font-weight: 700;
  }

  .home-bio:last-of-type {
    margin-bottom: 1.5rem;
  }

  .home-link-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .home-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .home-index-link {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--color-slate);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s ease;
  }

  .home-index-link:hover {
    text-decoration-color: var(--color-foreground);
  }

  .home-index-link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 0;
  }

  .action-link {
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-slate);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .action-link:hover {
    text-decoration-color: var(--color-foreground);
  }

  .action-link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .timeline-section {
    margin-bottom: 4rem;
  }

  .section-heading {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-muted-foreground);
    font-weight: 600;
    margin: 0 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .section-heading::after {
    content: '';
    flex: 1 1 auto;
    border-bottom: 1px solid currentColor;
    opacity: 0.16;
    transform: translateY(-0.25em);
  }

  .timeline-section .section-heading:not(:first-child) {
    margin-top: 2rem;
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-list li {
    margin: 0;
  }

  .timeline-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    margin: 0 -1rem;
    border-radius: 0.375rem;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .timeline-row:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  html.dark .timeline-row:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .timeline-row:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }

  .timeline-name {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .timeline-role {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-muted-foreground);
    text-align: right;
    flex-shrink: 0;
  }

  .recent-section {
    padding-top: 0;
  }

  .recent-posts {
    display: flex;
    flex-direction: column;
  }

  .recent-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    margin: 0 -1rem;
    border-radius: 0.375rem;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .recent-item:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  html.dark .recent-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .recent-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .recent-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-muted-foreground);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-body);
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color 0.2s ease;
    margin-top: 1.5rem;
  }

  @media (max-width: 520px) {
    .timeline-row,
    .recent-item {
      align-items: flex-start;
      gap: 0.35rem;
    }

    .recent-item {
      flex-direction: column;
    }

    .recent-meta {
      white-space: normal;
    }
  }

  .view-all-link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .view-all-link:hover {
    color: var(--color-foreground);
  }
</style>

---
import BlogLayout from '../layouts/BlogLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { homeLinkGroups } from '../data/site-navigation';
---

<BlogLayout title="Suhas Darsi" description="Notes, resources, and ways to connect with Suhas Darsi." centered>
  <div class="home-hub">
  <header class="home-header">
    <h1 class="page-heading">Suhas Darsi</h1>
    <p class="home-tagline">Founder · Researcher · Writer</p>
    <SocialLinks centered />
  </header>

  <div class="home-link-groups">
    {homeLinkGroups.map((group) => (
      <nav class="home-link-group" aria-label={group.label}>
        <h2 class="home-link-label">{group.label}</h2>
        <ul class="home-index">
          {group.links.map((link) => (
            <li>
              <a href={link.href} class="home-index-link" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  </div>
</BlogLayout>

<style>
  .home-hub { width: 100%; max-width: 28rem; text-align: center; }
  .home-header { margin-bottom: 3rem; }
  .page-heading { margin: 0 0 0.25rem; }
  .home-tagline {
    margin: 0 0 1.5rem;
    color: var(--color-muted-foreground);
    font-family: var(--font-sans);
    font-size: var(--text-body);
  }
  .home-link-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    max-width: 24rem;
    margin-inline: auto;
    text-align: left;
  }
  .home-link-group {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.875rem;
    font-family: var(--font-sans);
    line-height: 1.6;
  }
  .home-link-label { margin: 0; color: var(--color-muted-foreground); font-family: var(--font-sans); font-weight: 500; font-size: 0.875rem; }
  .home-index {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-index-link {
    color: var(--color-foreground);
    font-size: var(--text-body);
    text-decoration: underline;
    text-decoration-color: var(--color-slate);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s ease;
  }
  .home-index-link:hover { text-decoration-color: var(--color-foreground); }
</style>

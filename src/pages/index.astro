---
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suhasdarsi.com';
const canonicalUrl = `${siteUrl}/`;
const title = 'Suhas Darsi';
const description = 'Suhas Darsi — practical writing about AI security, agent systems, and network risk.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/libron/Libron-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content="Astro" />
    <meta name="description" content={description} />
    <meta name="author" content="Suhas Darsi" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Suhas Darsi" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@suhas_darsi" />
    <meta name="twitter:creator" content="@suhas_darsi" />
    <meta name="theme-color" content="#000000" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Suhas Darsi — Notes" href="/rss.xml" />
    <title>{title}</title>
    <style>
      @font-face {
        font-family: 'Libron';
        src: url('/fonts/libron/Libron-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Libron';
        src: url('/fonts/libron/Libron-Bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      :root {
        --font-serif: 'Libron', Georgia, 'Times New Roman', serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --bg: #000;
        --ink: #e8e6e1;
        --mute: #a19e98;
        --acc: #e8875f;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
      }
      body {
        font: 18px/1.6 var(--font-serif);
        -webkit-font-smoothing: antialiased;
      }
      canvas.ocean {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: block;
        font-family: var(--font-mono);
        z-index: 0;
      }
      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        display: flex;
        justify-content: center;
        gap: 26px;
        padding: 22px;
      }
      nav a {
        color: var(--mute);
        text-decoration: none;
      }
      nav a[aria-current] {
        color: var(--ink);
      }
      nav a:hover {
        color: var(--ink);
      }
      a {
        color: var(--ink);
        text-decoration: underline dotted var(--mute);
        text-underline-offset: 4px;
      }
      a:hover {
        text-decoration-color: var(--acc);
        color: #fff;
      }
      a:focus-visible {
        outline: 1px solid var(--acc);
        outline-offset: 3px;
      }
      main {
        position: relative;
        z-index: 1;
        pointer-events: none;
      }
      main a {
        pointer-events: auto;
      }
      .intro {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0 0 9vh;
      }
      .block {
        width: min(600px, 100% - 44px);
        margin-left: max(22px, calc(50vw - 420px));
        background: rgba(0, 0, 0, 0.9);
        padding: 14px 16px;
        border-radius: 2px;
      }
      .epi {
        color: var(--acc);
        margin: 0 0 30px;
      }
      p {
        margin: 0 0 14px;
      }
      .dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        background: var(--acc);
        margin-right: 8px;
        animation: blink 1.6s steps(1) infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .dot {
          animation: none;
        }
      }
      .social {
        color: var(--mute);
      }
    </style>
  </head>
  <body>
    <canvas class="ocean" aria-hidden="true"></canvas>
    <nav aria-label="Primary">
      <a href="/" aria-current="page">home</a>
      <a href="/notes">notes</a>
      <a href="/about">about</a>
      <a href="/uses">uses</a>
    </nav>
    <main>
      <section class="intro">
        <div class="block">
          <p class="epi">Every network has a hub.<br />Every hub is a way in.</p>
          <p>Hi, I'm Suhas.</p>
          <p><span class="dot" aria-hidden="true"></span>Building <a href="https://superalign.ai">SuperAlign</a>, as co-founder.</p>
          <p>I write about how AI systems fail and build small tools along the way.</p>
          <p>Before that, Founder @ <a href="https://www.linkedin.com/company/aztlan/">Aztlan</a>; Masters in AI @ <a href="https://www.iiit.ac.in/">IIIT Hyderabad</a>.</p>
          <p class="social"><a href="https://booking.akiflow.com/suhas--a84d">say hello</a> / <a href="https://www.linkedin.com/in/suhasdarsi/">linkedin</a> / <a href="https://x.com/suhas_darsi">x</a> / <a href="mailto:suhas@superalign.ai">email</a></p>
        </div>
      </section>
    </main>
    <script src="/flock.js" type="module"></script>
  </body>
</html>

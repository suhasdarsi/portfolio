---
import BlogLayout from '../layouts/BlogLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AppMark from '../components/AppMark.astro';
import { homeLinkGroups, primaryCta } from '../data/site-navigation';
import { getPublishedBlogEntriesByDate } from '../utils/content';
import { formatDate } from '../utils/date';

const recentNotes = (await getPublishedBlogEntriesByDate()).slice(0, 3);
---

<BlogLayout title="Suhas Darsi" description="Notes, micro-apps, and ways to connect with Suhas Darsi.">
  <div class="home-hub">
    <header class="home-header">
      <h1 class="page-heading">Suhas Darsi</h1>
      <p class="home-tagline">Founder · Researcher · Writer</p>
      <p class="home-intro">
        Co-founder at <a href="https://superalign.ai" target="_blank" rel="noopener noreferrer" class="link-underline">SuperAlign</a>.
        I write about how AI systems fail and build small tools along the way.
      </p>
      <div class="home-actions">
        <a href={primaryCta.href} target="_blank" rel="noopener noreferrer" class="button home-cta">
          {primaryCta.label}
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>
        <SocialLinks />
      </div>
    </header>

    {recentNotes.length > 0 && (
      <nav class="home-link-group" aria-label="Recent notes">
        <h2 class="section-label">Recent notes</h2>
        <ul class="rows">
          {recentNotes.map((post) => (
            <li>
              <a href={`/notes/${post.id}`} class="row row-stack">
                <span class="row-title">{post.data.title}</span>
                <span class="row-meta">{formatDate(post.data.pubDate)}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {homeLinkGroups.map((group) => (
      <nav class="home-link-group" aria-label={group.label}>
        <h2 class="section-label">{group.label}</h2>
        {group.description && <p class="home-group-description">{group.description}</p>}
        <ul class="rows">
          {group.links.map((link) => (
            <li>
              <a href={link.href} class="row row-stack">
                <span class="row-title">{'mark' in link && <AppMark mark={link.mark} class="row-mark" />}{link.label}</span>
                <span class="row-meta">{link.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <p class="home-footnote">
      Follow new notes via <a href="/rss.xml" class="link-underline">RSS</a>.
    </p>
  </div>
</BlogLayout>

<style>
  .home-header { margin-bottom: 3.5rem; }
  .home-tagline { margin-top: 0.25rem; font-family: var(--font-sans); color: var(--color-muted-foreground); }
  .home-intro { margin-top: 1.25rem; color: var(--color-body-text); text-wrap: pretty; }
  .home-intro a { color: var(--color-foreground); }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.25rem; margin-top: 1.75rem; }
  .home-cta { padding-inline: 1.25rem; }
  .home-cta:hover .row-arrow { transform: translate(2px, -2px); }
  .home-link-group { margin-bottom: 2.75rem; }
  .home-group-description { margin: -0.25rem 0 0.375rem; color: var(--color-muted-foreground); }
  .home-footnote { color: var(--color-muted-foreground); }
  .row-title :global(.row-mark) { margin-right: 0.375rem; }
  .home-footnote a { color: var(--color-foreground); }
</style>

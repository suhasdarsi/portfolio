---
import CopyEmail from '../components/CopyEmail.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { noteCover } from '../notes/cover';
import { getNoteLinks, getNotes, noteHref } from '../notes/notes';
import { formatDate } from '../site/format';
import NotePreviews from '../components/NotePreviews.astro';
import NoteGraph from '../components/NoteGraph.astro';
import NoteStage from '../components/NoteStage.astro';
import { site } from '../site/site';
import { person, website } from '../site/structured-data';

const posts = await getNotes();
const links = getNoteLinks(posts);
const notes = posts.map((post) => ({
  href: noteHref(post.id),
  title: post.data.title,
  desc: post.data.description,
  date: formatDate(post.data.pubDate, { year: true }),
  cover: noteCover(post.id, links.get(post.id)!),
  stage: post.data.stage,
}));
// The newest notes get a card with a cover; the graph beside them reaches every note.
const cards = notes.slice(0, 4);
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<SiteLayout jsonLd={[website(), person()]} title="Suhas Darsi — AI Security Notes and Micro-Apps" description="Notes on AI security, agent systems, and network risk, plus micro-apps and ways to connect with Suhas Darsi.">
  <section class="g-hero">
    <h1 class="serif">I study how AI systems fail, and how to deploy them safely.</h1>
    <p class="g-sub">I’m {site.name}, co-founder of <a class="g-link" href={site.company.url} {...external}>{site.company.name}</a>, where we help security teams see and control how AI is used in their organizations. I write about what happens when AI becomes the hub everything else connects through.</p>
    <div class="elsewhere">
      <CopyEmail icon />
      <a href={site.linkedin} {...external}>LinkedIn</a>
      <a href={site.x} {...external}>X</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </section>

  <section id="writing" class="g-section">
    <div class="g-head">
      <h2 class="serif">Notes</h2>
      <p class="lede">Every network has a hub. Every hub is a way in. These notes on AI security link to each other, so start anywhere and follow the threads. <a class="g-link" href="/notes">All notes</a></p>
    </div>
    <div class="g-grid">
      <div class="g-cards">
        {cards.map((note) => (
          <a class="g-card" href={note.href}>
            <span class="g-cover"><svg viewBox="0 0 320 220" aria-hidden="true" set:html={note.cover} /></span>
            <span class="g-title serif">{note.title}</span>
            <span class="g-desc">{note.desc}</span>
            <span class="g-meta"><NoteStage stage={note.stage} /><span>{note.date}</span></span>
          </a>
        ))}
      </div>
      <NoteGraph notes={posts} links={links} size={360} />
    </div>
  </section>

  <NotePreviews slot="after" notes={posts} links={links} />
</SiteLayout>

<style is:global>
  /* Garden look: a large serif headline, a thin section heading, note cards with diagram covers beside a graph of every note. */
  .g-hero { display: grid; gap: 24px; padding-block: 64px 96px; }
  .g-hero h1 { font-size: 80px; line-height: 1.1; font-weight: 400; letter-spacing: -.02em; max-width: 28ch; text-wrap: balance; }
  /* The same serif as the lede on every other page, one size up; a light sans here went thin on the dark theme. */
  .g-sub { font-family: "Geist Serif", serif; font-size: 28px; line-height: 1.45; font-weight: 400; color: var(--body); max-width: 30em; text-wrap: pretty; }
  /* a.: must beat the site's a { color: inherit }. The serif has no bold, so links in the intros are underlined to stand apart from the text. */
  .sd a.g-link { color: var(--accent-text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, var(--accent-text) 45%, transparent); }
  .sd a.g-link:hover { text-decoration-color: var(--accent-text); }
  .g-section { padding-bottom: 64px; }
  .g-head { display: grid; gap: 12px; padding-bottom: 48px; }
  .g-head h2 { font-size: 44px; line-height: 1.1; letter-spacing: -.02em; font-weight: 400; }
  .g-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .g-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .g-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
  @media (max-width: 760px) {
    .g-hero { padding-block: 40px 64px; }
    .g-hero h1 { font-size: 44px; }
    .g-sub { font-size: 22px; }
    .g-section { padding-bottom: 64px; }
  }
  @media (max-width: 560px) { .g-cards { grid-template-columns: minmax(0, 1fr); } }
</style>

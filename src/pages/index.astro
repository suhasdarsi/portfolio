---
import CopyEmail from '../components/CopyEmail.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getNoteLinks, getNotes, noteHref } from '../notes/notes';
import { formatDate } from '../site/format';
import { roles, site } from '../site/site';
import { person, website } from '../site/structured-data';
import { designSystems } from '../swatchbook/design-systems';
import { toolCategories } from '../toolshed/categories';
import { getTools, inCategory } from '../toolshed/tools';

const posts = await getNotes();
const links = getNoteLinks(posts);
const notes = posts.map((post) => ({
  href: noteHref(post.id),
  title: post.data.title,
  desc: post.data.description,
  date: formatDate(post.data.pubDate),
  backlinks: links.get(post.id)!.linkedFrom.length,
}));
const tools = await getTools();
// The six biggest Toolshed categories, for the thumbnail.
const bars = toolCategories
  .map((category) => [category, inCategory(tools, category).length] as const)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6);
const barMax = bars[0][1];


function qrCells() {
  const cells: boolean[] = [];
  const finder = (x: number, y: number, ox: number, oy: number) => {
    const dx = x - ox, dy = y - oy;
    if (dx < 0 || dy < 0 || dx > 6 || dy > 6) return null;
    return dx === 0 || dy === 0 || dx === 6 || dy === 6 || (dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4);
  };
  let seed = 7;
  for (let y = 0; y < 21; y++) for (let x = 0; x < 21; x++) {
    let on = finder(x, y, 0, 0) ?? finder(x, y, 14, 0) ?? finder(x, y, 0, 14);
    if (on === null) {
      const near = (x < 8 && y < 8) || (x > 12 && y < 8) || (x < 8 && y > 12);
      seed = (seed * 1103515245 + 12345) % 2147483648;
      on = near ? false : seed % 100 < 47;
    }
    cells.push(on);
  }
  return cells;
}
const qr = qrCells();
const spines = [['Carbon', '78%'], ['Primer', '92%'], ['GOV.UK', '70%'], ['Polaris', '86%'], ['Radix', '64%'], ['Fluent 2', '96%']];
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<SiteLayout jsonLd={[website(), person()]} title="Suhas Darsi — AI Security Notes and Micro-Apps" description="Notes on AI security, agent systems, and network risk, plus micro-apps and ways to connect with Suhas Darsi.">
  <section style="padding-top: 64px; padding-bottom: 64px; display: grid; gap: 24px;">
    <h1 class="intro serif">Hi, I'm Suhas. I co-founded <a class="tlink" href={site.company.url} {...external}>{site.company.name}</a> and spend my days on how AI systems fail. <span class="soft">Here I write about it, and make tiny apps anyone can open and use.</span></h1>
    <p class="epigraph">Every network has a hub. Every hub is a way in.<span class="caret" aria-hidden="true"></span></p>
    <div class="elsewhere">
      <CopyEmail icon />
      <a href={site.linkedin} {...external}>LinkedIn</a>
      <a href={site.x} {...external}>X</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </section>

  <section id="writing" class="sec">
    <div class="sec-label">
      <h2>Garden</h2>
      <p>Notes on AI security and how networks fail. They link to each other, so start anywhere and follow the threads.</p>
    </div>
    <div style="display: grid; gap: 24px;">
      <div class="rows">
        {notes.map((note) => (
          <a class="note" href={note.href}>
            <span class="n" aria-hidden="true"><span class="node"></span></span>
            <span class="t">{note.title}</span>
            <span class="when">{note.date}</span>
            <span class="d">{note.desc}</span>
            <span class="links">Linked from {note.backlinks} {note.backlinks === 1 ? 'note' : 'notes'}</span>
          </a>
        ))}
      </div>
      <a class="tlink" href="/notes" style="justify-self: start; font-size: 16px;">All notes</a>
    </div>
  </section>

  <section id="apps" class="sec">
    <div class="sec-label">
      <h2>Tiny apps</h2>
      <p>Small tools that each do one thing. Open one and use it. No account, no login.</p>
    </div>
    <div class="apps">
      <a class="app" href="/pocket-card">
        <div class="thumb" aria-hidden="true">
          <div class="pass">
            <div style="display: grid; gap: 4px; min-width: 0;"><span class="pn">Your Name</span><span class="pr">Role · Company</span></div>
            <div class="qr">{qr.map((on) => <span class:list={['q', { on }]}></span>)}</div>
          </div>
        </div>
        <span class="an">Pocket Card</span>
        <span class="ad">Make a business card for Apple Wallet. Nothing you type is saved.</span>
      </a>
      <a class="app" href="/swatchbook">
        <div class="thumb" aria-hidden="true">
          <div class="spines">{spines.map(([name, h]) => <div class="spine" style={`height: ${h};`}><span>{name}</span></div>)}</div>
        </div>
        <span class="an">Swatchbook</span>
        <span class="ad">A directory of {designSystems.length} public design systems, from product teams to governments.</span>
      </a>
      <a class="app" href="/toolshed">
        <div class="thumb" aria-hidden="true">
          <div class="bars">{bars.map(([name, count]) => <div class="bar"><span>{name}</span><span class="tr"><span class="fl" style={`width: ${Math.round((count / barMax) * 100)}%;`}></span></span><span class="c">{count}</span></div>)}</div>
        </div>
        <span class="an">Toolshed <span class="badge">alpha</span></span>
        <span class="ad">My research on the security tools market: {tools.length} tools in {toolCategories.length} categories. Free to read.</span>
      </a>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label"><h2>About</h2><p>Background in computer vision research. These days, AI security.</p></div>
    <div style="display: grid; gap: 24px;">
      <div class="rows">
        {roles.map((r) => <a class="mrow" href={r.url} {...external}><span>{r.name}</span><span class="l">{r.current ? r.role : `${r.role}, before`}</span></a>)}
      </div>
      <a class="tlink" href="/about" style="justify-self: start; font-size: 16px;">More about me</a>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label"><h2>Uses</h2><p>What's on my desk and in my dock.</p></div>
    <div style="display: grid; gap: 24px;">
      <p class="uses">I write code in <b>Zed</b> and <b>OpenCode</b>, think with <b>Claude</b> and <b>Perplexity</b>, keep notes in <b>Obsidian</b>, and plan the week in <b>Akiflow</b> and <b>Things 3</b>. Most of it runs on a <b>Mac Mini M4</b> with a <b>Keychron K8 Pro</b>, and this site runs on <b>Cloudflare</b>.</p>
      <a class="tlink" href="/uses" style="justify-self: start; font-size: 16px;">The full list</a>
    </div>
  </section>

  <section class="sec" style="padding-bottom: 64px;">
    <div class="sec-label"><h2>Say hello</h2></div>
    <p style="font-size: 16px; color: var(--body); max-width: 52ch;">Write to <CopyEmail style="color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px;" /> or <a class="tlink" href={site.booking} {...external}>book a time to talk</a>. New notes go out on <a class="tlink" href="/rss.xml">RSS</a>.</p>
  </section>

</SiteLayout>

<style is:global>
  .intro { font-size: 28px; line-height: 1.32; letter-spacing: -.012em; color: var(--ink); max-width: 30ch; font-weight: 400; }
  .intro .soft { color: var(--muted); }
  .epigraph { font-family: Geist, sans-serif; font-size: 13px; color: var(--muted); }
  .caret { display: inline-block; width: 7px; height: 15px; margin-left: 4px; vertical-align: -2px; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .elsewhere { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 16px; color: var(--muted); }
  .elsewhere a:hover { color: var(--ink); }
  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .app { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .thumb { height: 168px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; position: relative; transition: border-color .18s; }
  .app:hover .thumb { border-color: var(--line-strong); }
  .app .an { display: flex; align-items: center; gap: 8px; font-weight: 500; font-size: 16px; }
  .app .ad { font-size: 16px; line-height: 1.5; color: var(--muted); }
  .app:hover .an { color: var(--accent-text); }
  .pass { position: absolute; left: 22px; right: 22px; top: 24px; bottom: 24px; border-radius: 12px; background: var(--ink); color: var(--bg); padding: 12px; display: flex; justify-content: space-between; align-items: flex-end; gap: 8px; }
  .pass .pn { font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
  .pass .pr { font-size: 13px; opacity: .7; }
  .pass .pn, .pass .pr { line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qr { display: grid; grid-template-columns: repeat(21, 2px); grid-auto-rows: 2px; padding: 4px; background: #ffffff; border-radius: 5px; }
  .q { background: #ffffff; }
  .q.on { background: #16171a; }
  .spines { position: absolute; inset: 18px 18px 0; display: flex; align-items: flex-end; gap: 4px; }
  .spine { flex: 1; border-radius: 4px 4px 0 0; background: var(--soft); border: 1px solid var(--line); border-bottom: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 8px; overflow: hidden; }
  .spine span { writing-mode: vertical-rl; transform: rotate(180deg); font-family: Geist, sans-serif; font-size: 13px; line-height: 1; color: var(--muted); white-space: nowrap; }
  .bars { position: absolute; inset: 20px 20px; display: grid; gap: 8px; align-content: center; }
  .bar { display: grid; grid-template-columns: 96px minmax(0, 1fr) 22px; gap: 8px; align-items: center; font-size: 13px; line-height: 1.2; color: var(--muted); }
  .bar > span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar .tr { height: 4px; border-radius: 4px; background: var(--soft); overflow: hidden; }
  .bar .fl { height: 100%; background: var(--line-strong); border-radius: 4px; }
  .app:hover .bar .fl { background: var(--accent); }
  .bar .c { font-family: Geist, sans-serif; text-align: right; }
  .uses { font-size: 16px; line-height: 1.75; color: var(--body); max-width: 52ch; }
  .uses b { font-weight: 500; color: var(--ink); }
  @media (max-width: 760px) { .apps { grid-template-columns: minmax(0, 1fr); } }
</style>

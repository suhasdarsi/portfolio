---
import BlogLayout from '../layouts/BlogLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AppMark from '../components/AppMark.astro';
import { homeLinkGroups, primaryCta } from '../data/site-navigation';
import { getPublishedBlogEntriesByDate } from '../utils/content';
import { formatDate } from '../utils/date';

const recentNotes = (await getPublishedBlogEntriesByDate()).slice(0, 3);
---

<BlogLayout title="Suhas Darsi" description="Notes, micro-apps, and ways to connect with Suhas Darsi.">
  <div class="home-hub">
    <header class="home-header">
      <p class="home-status"><span class="home-status-dot" aria-hidden="true"></span>Building SuperAlign</p>
      <h1 class="page-heading">Suhas Darsi</h1>
      <p class="home-tagline">Founder · Researcher · Writer</p>
      <p class="home-intro">
        Co-founder at <a href="https://superalign.ai" target="_blank" rel="noopener noreferrer" class="link-underline">SuperAlign</a>.
        I write about how AI systems fail and build small tools along the way.
      </p>
      <div class="home-actions">
        <a href={primaryCta.href} target="_blank" rel="noopener noreferrer" class="button home-cta">
          {primaryCta.label}
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>
        <SocialLinks />
      </div>
    </header>

    {recentNotes.length > 0 && (
      <nav class="home-link-group" aria-label="Recent notes">
        <h2 class="section-label">Recent notes</h2>
        <ul class="rows">
          {recentNotes.map((post) => (
            <li>
              <a href={`/notes/${post.id}`} class="row row-stack">
                <span class="row-title">{post.data.title}</span>
                <span class="row-meta">{formatDate(post.data.pubDate)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/notes" class="home-more">All notes <span class="row-arrow" aria-hidden="true">→</span></a>
      </nav>
    )}

    {homeLinkGroups.map((group) => (
      <nav class="home-link-group" aria-label={group.label}>
        <h2 class="section-label">{group.label}</h2>
        {group.description && <p class="home-group-description">{group.description}</p>}
        <ul class:list={['rows', { 'app-cards': group.links.some((link) => 'mark' in link) }]}>
          {group.links.map((link) => 'mark' in link ? (
            <li>
              <a href={link.href} class="app-card">
                <span class="app-card-mark"><AppMark mark={link.mark} size="1.5rem" /></span>
                <span class="app-card-title"><span class="app-card-name">{link.label}</span><span class="row-arrow" aria-hidden="true">→</span></span>
                <span class="app-card-meta">{link.meta}</span>
              </a>
            </li>
          ) : (
            <li>
              <a href={link.href} class="row row-stack">
                <span class="row-title">{link.label}</span>
                <span class="row-meta">{link.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <p class="home-footnote">
      Follow new notes via <a href="/rss.xml" class="link-underline">RSS</a>.
    </p>
  </div>
</BlogLayout>

<style>
  .home-header { margin-bottom: 4rem; }
  .home-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.125rem 0.75rem 0.125rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
  }
  .home-status-dot {
    position: relative;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: #3f9b62;
  }
  .home-status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: status-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes status-ping {
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
  .home-tagline { margin-top: 0.375rem; font-family: var(--font-sans); color: var(--color-muted-foreground); }
  .home-intro { margin-top: 1.25rem; max-width: 34rem; font-size: 1.125rem; line-height: 1.55; color: var(--color-body-text); text-wrap: pretty; }
  .home-intro a { color: var(--color-foreground); }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.25rem; margin-top: 2rem; }
  .home-cta { padding-inline: 1.25rem; }
  .home-cta:hover .row-arrow { transform: translate(2px, -2px); }
  .home-link-group { margin-bottom: 3.25rem; }
  .home-group-description { margin: -0.25rem 0 0.75rem; color: var(--color-muted-foreground); }
  .home-more {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: 0.5rem;
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .home-more:hover { color: var(--color-foreground); }
  .home-more:hover .row-arrow { transform: translateX(3px); }

  /* Micro-apps read as small objects, not links in a list. */
  .app-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.75rem; }
  .app-card {
    display: grid;
    gap: 0.125rem;
    height: 100%;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: color-mix(in srgb, var(--color-subtle) 45%, transparent);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s cubic-bezier(0.2, 0, 0, 1);
  }
  .app-card:hover {
    border-color: var(--color-muted-foreground);
    background: var(--color-subtle);
    transform: translateY(-2px);
  }
  .app-card:active { transform: translateY(0); }
  .app-card-mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    border-radius: 0.625rem;
    background: var(--color-muted);
  }
  .app-card-title { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; font-weight: 700; }
  .app-card-title .row-arrow { color: var(--color-muted-foreground); }
  .app-card:hover .row-arrow { color: var(--color-foreground); transform: translateX(3px); }
  .app-card-meta { color: var(--color-muted-foreground); }
  .home-footnote { color: var(--color-muted-foreground); }
  .home-footnote a { color: var(--color-foreground); }
</style>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories as systemCategories, designSystems } from '../swatchbook/design-systems';
import { hostname } from '../site/format';

const categories = ['All', ...systemCategories];
const counts = Object.fromEntries(categories.map((c) => [c, c === 'All' ? designSystems.length : designSystems.filter((s) => s.category === c).length]));
---

<SiteLayout title="Swatchbook — Design Systems — Suhas Darsi" description="Swatchbook: a searchable collection of company and public-service design systems, with links to their official documentation." current="apps">
  <section class="page-head">
    <span class="eyebrow">Tiny app</span>
    <h1 class="title">Swatchbook</h1>
    <p class="lede">A directory of public design systems from product teams, platforms and governments. Find one to learn from, then open it on its own site.</p>
  </section>

  <section style="display: grid; gap: 16px; padding-bottom: 24px;">
    <form class="field-wrap" role="search" id="system-search-form">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <label for="system-search" class="vh">Find a design system</label>
      <input id="system-search" class="field" type="search" placeholder="Find a design system by name or owner" autocomplete="off" aria-controls="system-list" />
    </form>
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
      <div class="chips" role="group" aria-label="Category">
        {categories.map((category) => (
          <button type="button" class:list={['chip', { on: category === 'All' }]} data-category={category} aria-pressed={category === 'All' ? 'true' : 'false'}>{category} <span class="k" aria-hidden="true">{counts[category]}</span></button>
        ))}
      </div>
      <span class="faint" style="font-size: 13px;" id="system-count" role="status" aria-live="polite">{designSystems.length} systems</span>
    </div>
  </section>

  <ul id="system-list" class="sgrid" style="padding-bottom: 64px;">
    {designSystems.map((system) => (
      <li data-system data-category={system.category} data-search={`${system.name} ${system.owner} ${system.category}`.toLowerCase()}>
        <a class="sys" href={system.url} target="_blank" rel="noopener noreferrer"><span class="n">{system.name}</span><span class="c">{system.category}</span><span class="o">{system.owner} · {hostname(system.url)}</span><span class="vh"> (opens in a new tab)</span></a>
      </li>
    ))}
  </ul>
  <p id="system-empty" class="muted" style="padding-bottom: 64px;" hidden>No systems match.</p>
</SiteLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#system-search')!;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.chips button'));
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('[data-system]'));
  const count = document.getElementById('system-count')!;
  const empty = document.getElementById('system-empty')!;
  let category = 'All';

  function filterSystems() {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    for (const item of items) {
      const matches = (category === 'All' || item.dataset.category === category) && (item.dataset.search ?? '').includes(query);
      item.hidden = !matches;
      if (matches) visible++;
    }
    count.textContent = `${visible} ${visible === 1 ? 'system' : 'systems'}`;
    empty.hidden = visible > 0;
    empty.textContent = query ? `No systems match “${input.value.trim()}”.` : 'No systems in this category.';
  }

  input.addEventListener('input', filterSystems);
  document.getElementById('system-search-form')!.addEventListener('submit', (event) => event.preventDefault());
  for (const button of buttons) {
    button.addEventListener('click', () => {
      category = button.dataset.category ?? 'All';
      for (const candidate of buttons) {
        candidate.setAttribute('aria-pressed', String(candidate === button));
        candidate.classList.toggle('on', candidate === button);
      }
      filterSystems();
    });
  }
</script>

<style is:global>
  .sgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 24px; list-style: none; margin: 0; padding: 0; }
  .sys { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; padding-block: 12px; border-bottom: 1px solid var(--line); align-items: baseline; }
  .sys .n { font-weight: 500; font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sys .c { font-size: 13px; color: var(--faint); white-space: nowrap; }
  .sys .o { grid-column: 1 / -1; font-size: 13px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sys:hover .n { color: var(--accent-text); }
  @media (max-width: 1000px) { .sgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .sgrid { grid-template-columns: minmax(0, 1fr); } }
</style>

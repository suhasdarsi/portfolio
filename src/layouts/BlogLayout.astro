---
import Header from '../components/Header.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  wide?: boolean;
  centered?: boolean;
  noindex?: boolean;
  author?: string;
}

const { title, description, ogType = 'website', ogImage, wide = false, centered = false, noindex = false, author = 'Suhas Darsi' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} ogType={ogType} ogImage={ogImage} noindex={noindex} author={author} />
  </head>
  <body class="min-h-screen bg-background">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header wide={wide} />

    <main
      id="main-content"
      class:list={[wide ? 'max-w-6xl' : 'max-w-[40rem]', 'site-main w-full mx-auto px-4', centered ? 'flex items-center justify-center py-12' : 'pt-2 pb-10']}
    >
      <div class="focus-panel">
        <slot />
      </div>
    </main>
  </body>
</html>

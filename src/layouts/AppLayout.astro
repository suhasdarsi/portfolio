---
// Micro-apps (Pocket Card, Swatchbook) are independent apps: no site navigation, Say hello or search.
// They keep the focus panel, a way home and the theme toggle. On wide screens the home link heads the
// left rail and the toggle heads the right rail, above the app's own actions (.page-actions in global.css).
import SiteHead from '../components/SiteHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} noindex={noindex} />
  </head>
  <body class="app-shell min-h-screen bg-background">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="app-header">
      <div class="app-header-inner">
        <a href="/" class="app-home" aria-label="Suhas Darsi, home">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Suhas Darsi
        </a>
        <div class="app-controls rail-controls">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main-content" class="site-main w-full max-w-[40rem] mx-auto px-4 pt-2 pb-10">
      <div class="focus-panel">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  .app-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--max-width-shell);
    height: 4.5rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .app-home {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-muted-foreground);
    font-size: var(--type-sm);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .app-home:hover {
    color: var(--color-foreground);
  }
  .app-controls {
    display: flex;
  }

  /* Wide screens: no top bar, same geometry as the site header's rails (Header.astro). */
  @media (min-width: 70rem) {
    :global(body.app-shell) {
      --rail-start-offset: 3.5rem;
      --rail-end-offset: 4.25rem;
    }
    .app-header-inner {
      position: relative;
      height: 2rem;
    }
    .app-home,
    .app-controls {
      position: absolute;
      top: 5.25rem;
      width: 11rem;
    }
    .app-home {
      right: calc(100% + 0.5rem - 1px);
      line-height: 1.5rem;
    }
    .app-controls {
      left: calc(100% + 0.5rem - 1px);
    }
  }
</style>

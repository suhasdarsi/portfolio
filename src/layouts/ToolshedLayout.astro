---
// Toolshed is a full-width app with its own navigation, separate from the portfolio's reading layout.
// It's in alpha: every page says so, and search engines are asked not to index it yet.
import SiteHead from '../components/SiteHead.astro';
import ToolshedHeader from '../components/toolshed/Header.astro';
import ToolshedFooter from '../components/toolshed/Footer.astro';

interface Props {
  title: string;
  description?: string;
  turnstile?: boolean;
}

const { title, description, turnstile = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} noindex turnstile={turnstile} />
  </head>
  <body class="toolshed">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <ToolshedHeader />
    <div class="ts-alpha" role="note">
      <p class="ts-container"><strong>Alpha.</strong> Toolshed is a work in progress: the tools, tags and market notes are incomplete and some will be wrong. Please don’t rely on it or share it yet.</p>
    </div>
    <main id="main-content" class="ts-container ts-main">
      <slot />
    </main>
    <ToolshedFooter />
  </body>
</html>

<style is:global>
  body.toolshed { min-height: 100vh; display: flex; flex-direction: column; background: var(--color-background); }
  .ts-container { width: 100%; max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }
  .ts-alpha { border-bottom: 1px solid var(--color-border); background: var(--color-muted); }
  .ts-alpha p { margin-block: 0; padding-block: 0.625rem; font-size: var(--type-sm); line-height: 1.5; color: var(--color-body-text); }
  .ts-alpha strong { font-weight: 600; color: var(--color-foreground); }
  .ts-main { flex: 1; padding-block: 2.5rem 4rem; }
  @media (max-width: 640px) { .ts-container { padding-inline: 1rem; } .ts-main { padding-top: 1.5rem; } }

  /* Shared Toolshed type: section titles and the small muted label above them. */
  .ts-section-title { margin: 0; font-size: var(--type-md); font-weight: 500; letter-spacing: -0.01em; color: var(--color-foreground); }
  .ts-eyebrow { margin: 0 0 0.375rem; font-size: var(--type-sm); color: var(--color-muted-foreground); }
  .ts-muted { color: var(--color-muted-foreground); }
</style>

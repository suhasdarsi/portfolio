---
// Toolshed is an independent app inside the site: its own top bar and footer around the wide column.
// It's in alpha: pages carry the alpha banner (About explains it in its own box instead), and search
// engines are asked not to index it yet.
import SiteHead from '../components/SiteHead.astro';
import ToolshedHeader from '../components/toolshed/Header.astro';
import ToolshedFooter from '../components/toolshed/Footer.astro';

interface Props {
  title: string;
  description?: string;
  turnstile?: boolean;
  // The home page shows a search box in the top bar; All tools has its own.
  search?: boolean;
  banner?: boolean;
}

const { title, description, turnstile = false, search = false, banner = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} noindex turnstile={turnstile} />
  </head>
  <body class="sd">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="page wide">
      <ToolshedHeader search={search} />
      {banner && (
        <p class="ts-banner" role="note" style="margin-top: 16px;"><b>Alpha.</b> Toolshed is a work in progress: the tools, tags and market notes are incomplete and some will be wrong. Please don’t rely on it or share it yet.</p>
      )}
      <main id="main-content">
        <slot />
      </main>
      <ToolshedFooter />
    </div>
  </body>
</html>

<style is:global>
  /* Shared by the Toolshed pages: the employer disclosure next to a tool, and lists filtered with [hidden]. */
  .emp { font-family: Geist, sans-serif; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--accent-text); margin-left: 8px; }
  .sd [hidden] { display: none !important; }
  /* Bold stops at 600, as in the design; Markdown writes <strong> where the design has <b>. */
  .sd h2.eyebrow { font-weight: 600; }
  .prose strong { color: var(--ink); font-weight: 600; }
</style>

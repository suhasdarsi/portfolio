---
// A note's growth stage: a small plant drawing and the stage name. Renders nothing for a note with no stage.
import { stageInfo, type NoteStage } from '../notes/notes';

interface Props {
  stage?: NoteStage;
}
const { stage } = Astro.props;
const info = stage && stageInfo[stage];
// 16x16 drawings: a sprout, a stem with a bud, a tree.
const drawing: Record<NoteStage, string> = {
  seedling: '<path d="M8 14V8"/><path d="M8 8C8 5.5 6.2 4 3.5 4 3.5 6.5 5.3 8 8 8Z"/><path d="M8 9.5C8 7.6 9.4 6.5 11.5 6.5 11.5 8.4 10.1 9.5 8 9.5Z"/>',
  budding: '<path d="M8 14V7"/><path d="M8 7C6.3 7 5.5 5.6 5.5 4.3 5.5 3 6.6 2 8 2s2.5 1 2.5 2.3C10.5 5.6 9.7 7 8 7Z"/><path d="M8 11C8 9.4 6.8 8.5 5 8.5 5 10.1 6.2 11 8 11Z"/><path d="M8 12.5c0-1.6 1.2-2.5 3-2.5 0 1.6-1.2 2.5-3 2.5Z"/>',
  evergreen: '<path d="M8 14v-2.5"/><path d="M8 2 4.5 6.5h2L3.5 11.5h9L9.5 6.5h2Z"/>',
};
---

{info && (
  <span class="stage" title={info.means}>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={drawing[stage]} />
    {info.label}
  </span>
)}

---
// The note's neighbourhood: this note in the middle, a node for every note linked with it, in either direction.
// Each node is a link. Its name shows in the hover preview (NotePreviews) and is read out by screen readers.
import { GRAPH_SIZE, localGraph } from '../notes/cover';
import { noteHref, type Note, type NoteLinks } from '../notes/notes';

interface Props {
  note: Note;
  links: NoteLinks;
  /** Every published note by id, to name the neighbours. */
  byId: Map<string, Note>;
}
const { note, links, byId } = Astro.props;
const { nodes, hidden } = localGraph(note.id, links);
const middle = GRAPH_SIZE / 2;
---

{nodes.length > 0 && (
  <nav class="graph" aria-label="Graph of linked notes">
    <span class="eyebrow">Graph</span>
    <svg viewBox={`0 0 ${GRAPH_SIZE} ${GRAPH_SIZE}`} role="group" aria-label={`${note.data.title} and its linked notes`}>
      {nodes.map((node) => <line x1={middle} y1={middle} x2={node.x} y2={node.y} />)}
      <circle class="here" cx={middle} cy={middle} r="9" />
      {nodes.map((node) => (
        <a href={noteHref(node.id)} aria-label={byId.get(node.id)!.data.title}>
          <circle class="hit" cx={node.x} cy={node.y} r="14" />
          <circle class="node" cx={node.x} cy={node.y} r="6" />
        </a>
      ))}
    </svg>
    {hidden > 0 && <span class="graph-key">and {hidden} more, listed below</span>}
  </nav>
)}

<style>
  .graph { display: grid; gap: 8px; font-size: 13px; color: var(--faint); }
  .graph svg { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .graph line { stroke: var(--ink); stroke-width: 1.2; opacity: .5; }
  .graph .here { fill: var(--accent-text); }
  .graph .node { fill: var(--surface); stroke: var(--ink); stroke-width: 1.4; transition: fill .15s; }
  .graph .hit { fill: transparent; }
  .graph a:hover .node, .graph a:focus-visible .node { fill: var(--ink); }
  .graph a:focus-visible { outline: none; }
  .graph a:focus-visible .hit { stroke: var(--focus); stroke-width: 2; }
  .graph-key { display: flex; flex-wrap: wrap; gap: 4px 16px; }
</style>

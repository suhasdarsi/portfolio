---
// The note's contents list: its sections, at the top of the rail beside the text (the rail is hidden under 1000px).
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

{sections.length > 0 && (
  <nav class="guide" aria-label="In this note">
    <span class="eyebrow">On this page</span>
    {sections.map((section) => <a href={`#${encodeURIComponent(section.slug)}`}>{section.text}</a>)}
  </nav>
)}

---
import { apps, pages } from '../../site/sections';
import { site } from '../../site/site';

const links = [{ title: 'Notes', href: '/notes' }, ...pages, ...apps, { title: 'RSS', href: '/rss.xml' }];
---

<footer class="foot">
  <span>© 2026 {site.name}</span>
  <nav aria-label="Footer">
    {links.map((link) => <a href={link.href}>{link.title}</a>)}
  </nav>
</footer>

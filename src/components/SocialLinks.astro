---
interface Props { centered?: boolean; }
const { centered = false } = Astro.props;
---

<div class:list={['social-links', { centered }]}>
    <div class="home-socials">
      <a href="https://www.linkedin.com/in/suhasdarsi/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://x.com/suhas_darsi" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X (Twitter)">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <button type="button" class="social-icon social-email" aria-label="Copy email address: suhas@superalign.ai" data-copy-email="suhas@superalign.ai">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span class="social-tip" role="status" aria-live="polite">Copy email</span>
      </button>
    </div>
</div>

<script>
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');

  copyEmailButton?.addEventListener('click', async () => {
    const email = copyEmailButton.getAttribute('data-copy-email');
    if (!email) return;

    const tip = copyEmailButton.querySelector('.social-tip');
    const original = tip?.textContent;

    try {
      await navigator.clipboard.writeText(email);
      if (tip) tip.textContent = 'copied ✓';
    } catch {
      window.location.href = `mailto:${email}`;
      return;
    }

    if (tip) {
      setTimeout(() => {
        tip.textContent = original || '';
      }, 1600);
    }
  });
</script>

<style>
  .home-socials {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .social-icon {
    position: relative;
    display: grid;
    place-items: center;
    /* 16px visual icon, 44px hit area: padding expands, negative margin restores flow. */
    padding: 0.875rem;
    margin: -0.875rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    color: var(--color-muted-foreground);
    transition: color 0.15s ease;
  }

  .social-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .social-icon:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .social-icon:hover {
    color: var(--color-foreground);
  }

  .social-tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.35rem 0.6rem;
    border-radius: 0.375rem;
    background: #2b2825;
    color: #f7f0e7;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .social-email:hover .social-tip,
  .social-email:focus-visible .social-tip {
    opacity: 1;
  }

  html.dark .social-icon:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .home-socials { flex-wrap: wrap; row-gap: 1rem; }
  .centered .home-socials { justify-content: center; }
</style>

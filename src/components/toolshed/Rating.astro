---
interface Props { rating: number; }
const { rating } = Astro.props;
---

<span class="tool-rating" role="img" aria-label={`${rating} out of 5`}>
  {[1, 2, 3, 4, 5].map((dot) => <span class:list={['dot', { on: dot <= rating }]} aria-hidden="true"></span>)}
</span>

<style>
  .tool-rating { display: inline-flex; gap: 3px; align-items: center; vertical-align: 0.05em; }
  .dot { width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--line-strong); }
  .dot.on { background: var(--ink); border-color: var(--ink); }
</style>

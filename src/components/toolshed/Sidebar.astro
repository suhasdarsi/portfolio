---
// The category list beside every category page. On phones it becomes a scrolling row above the content.
import { toolCategories, toolSlug, type ToolCategory } from '../../data/toolshed';
import type { Tool } from '../../utils/content';

interface Props { tools: Tool[]; current?: ToolCategory | 'all'; }
const { tools, current } = Astro.props;
const links = [
  { label: 'All tools', href: '/toolshed/tools', count: tools.length, active: current === 'all' },
  ...toolCategories.map((category) => ({
    label: category,
    href: `/toolshed/${toolSlug(category)}`,
    count: tools.filter((tool) => tool.categories.includes(category)).length,
    active: category === current,
  })),
];
---

<nav class="ts-sidebar" aria-label="Categories">
  <p class="ts-eyebrow">Categories</p>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={link.active ? 'page' : undefined}>
          <span>{link.label}</span><span class="count">{link.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .ts-sidebar { position: sticky; top: 5rem; align-self: start; }
  .ts-sidebar .ts-eyebrow { padding-left: 0.625rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  a {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-buttons);
    color: var(--color-body-text);
    font-size: var(--type-sm);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  a:hover { background: var(--color-muted); color: var(--color-foreground); }
  a[aria-current='page'] { background: var(--color-muted); color: var(--color-foreground); font-weight: 500; }
  .count { color: var(--color-muted-foreground); font-weight: 400; font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .ts-sidebar { position: static; margin-inline: -1rem; padding-inline: 1rem; overflow-x: auto; }
    .ts-sidebar .ts-eyebrow { display: none; }
    ul { display: flex; gap: 0.375rem; width: max-content; }
    a { border: 1px solid var(--color-border-strong); white-space: nowrap; }
  }
</style>

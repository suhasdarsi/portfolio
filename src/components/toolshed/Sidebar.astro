---
import { toolCategories, type ToolCategory } from '../../toolshed/categories';
import { categoryHref, inCategory, type Tool } from '../../toolshed/tools';

interface Props { tools: Tool[]; current?: ToolCategory | 'all'; }
const { tools, current } = Astro.props;
const links = [
  { label: 'All tools', href: '/toolshed/tools', count: tools.length, active: current === 'all' },
  ...toolCategories.map((category) => ({
    label: category,
    href: categoryHref(category),
    count: inCategory(tools, category).length,
    active: category === current,
  })),
];
---

<nav class="ts-side" aria-label="Categories">
  <span class="eyebrow" style="padding: 0 8px 8px;">Categories</span>
  {links.map((link) => (
    <a class:list={{ on: link.active }} href={link.href} aria-current={link.active ? 'page' : undefined}><span>{link.label}</span><span class="c">{link.count}</span></a>
  ))}
</nav>

---
import Rating from './Rating.astro';
import type { ToolCategory } from '../../toolshed/categories';
import { categoryHref, hasReview, tagsIn, toolLink, type Tool } from '../../toolshed/tools';
import { hostname } from '../../site/format';

interface Props { tool: Tool; category: ToolCategory; }
const { tool, category } = Astro.props;
const review = hasReview(tool) ? tool.review : undefined;
const link = toolLink(tool);
const tags = tagsIn(tool, category);
const elsewhere = tool.categories.filter((other) => other !== category);
---

<div class="tool" data-tool data-tags={JSON.stringify(tags)}>
  <span>
    <a class="nm" href={link.href} {...link.attrs}>{tool.name}{link.external && <span class="vh"> (opens in a new tab)</span>}</a>{tool.affiliated && <span class="emp">My employer</span>}{review?.data.rating && <> <Rating rating={review.data.rating} /></>}
  </span>
  <span class="h">{review?.data.verdict ?? hostname(tool.url)} {link.external ? '↗' : '→'}</span>
  <span class="tags">
    {tags.map((tag) => <span class="tag" data-tag-name={tag}>{tag}</span>)}
    {elsewhere.length > 0 && <span class="also">Also in {elsewhere.map((other, i) => <>{i > 0 && ', '}<a href={categoryHref(other, 'tools')}>{other}</a></>)}</span>}
  </span>
</div>

<style>
  .tool { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 16px; padding: 12px 4px; border-bottom: 1px solid var(--line); }
  .tool:hover { background: var(--soft); }
  .nm { font-weight: 500; font-size: 16px; }
  .nm::after { content: ''; position: absolute; inset: 0; }
  .h { font-family: Geist, sans-serif; font-size: 13px; color: var(--faint); }
  .tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { font-size: 13px; padding: 2px 8px; border-radius: 999px; background: var(--soft); color: var(--body); }
  .tag.on { background: var(--ink); color: var(--bg); }
  .also { font-size: 13px; color: var(--faint); }
  .also a { position: relative; z-index: 1; }
  .also a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>

---
import Rating from './Rating.astro';
import { toolSlug, type ToolCategory } from '../../data/toolshed';
import { hasReview, tagsIn, toolHref, type Tool } from '../../utils/content';

interface Props { tool: Tool; category: ToolCategory; }
const { tool, category } = Astro.props;
const review = hasReview(tool) ? tool.review : undefined;
const host = new URL(tool.url).hostname.replace(/^www\./, '');
const tags = tagsIn(tool, category);
const elsewhere = tool.categories.filter((other) => other !== category);
---

<li class="ts-card" data-tool data-tags={JSON.stringify(tags)}>
  <a href={review ? toolHref(tool) : tool.url} class="main" {...(review ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
    <span class="name">{tool.name}<span class="arrow" aria-hidden="true">{review ? '→' : '↗'}</span></span>
    <span class="sub">{review?.data.verdict ?? host}</span>
    {!review && <span class="sr-only"> (opens in a new tab)</span>}
  </a>
  <ul class="tags" aria-label="Tags">
    {review?.data.rating && <li><Rating rating={review.data.rating} /></li>}
    {tool.affiliated && <li class="tag employer">My employer</li>}
    {tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
  {elsewhere.length > 0 && (
    <p class="elsewhere">Also in {elsewhere.map((other, i) => <>{i > 0 && ', '}<a href={`/toolshed/${toolSlug(other)}/tools`}>{other}</a></>)}</p>
  )}
</li>

<style>
  .ts-card {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    transition: border-color 0.15s ease;
  }
  .ts-card:hover { border-color: var(--color-border-strong); }
  .main { display: grid; gap: 0.25rem; color: var(--color-foreground); text-decoration: none; }
  .name { display: flex; justify-content: space-between; gap: 0.5rem; font-weight: 500; letter-spacing: -0.01em; }
  .main:hover .name { text-decoration: underline; text-underline-offset: 3px; }
  .arrow { color: var(--color-muted-foreground); font-weight: 400; }
  .sub { font-size: var(--type-sm); color: var(--color-muted-foreground); overflow-wrap: anywhere; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem; align-items: center; }
  .tag { padding: 0.0625rem 0.4375rem; border-radius: var(--radius-sm); background: var(--color-muted); font-size: 0.75rem; line-height: 1.5; color: var(--color-body-text); }
  .tag.employer { background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-muted-foreground); }
  .elsewhere { margin: 0; font-size: 0.75rem; color: var(--color-muted-foreground); }
  .elsewhere a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .elsewhere a:hover { color: var(--color-foreground); }
</style>

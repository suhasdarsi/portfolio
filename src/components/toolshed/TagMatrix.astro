---
// A tag group drawn as a grid, e.g. AI security's agent types: who built the agent × who runs it.
import type { TagGroup } from '../../toolshed/catalog';

interface Props { group: TagGroup & { axes: NonNullable<TagGroup['axes']> }; counts: Map<string, number>; href: (tag: string) => string; }
const { group, counts, href } = Astro.props;
const { columns, rows } = group.axes;
const at = (row: number, column: number) => group.tags.find((tag) => tag.cell?.[0] === row && tag.cell?.[1] === column);
const lower = (text: string) => text.charAt(0).toLowerCase() + text.slice(1);
---

<div class="quad ts-matrix" style={`grid-template-columns: 150px repeat(${columns.length}, minmax(0, 1fr));`}>
  <span></span>{columns.map((column) => <span class="ax">{column}</span>)}
  {rows.map((row, r) => (
    <>
      <span class="rl">{row}</span>
      {columns.map((column, c) => {
        const tag = at(r, c);
        return tag ? (
          <a class="cell" href={href(tag.name)}>
            <span class="pos">{row} · {column}</span>
            <div class="top"><span class="nm">{tag.name}</span><span class="ct">{counts.get(tag.name) ?? 0} tools</span></div>
            {tag.examples && <p class="ex">{tag.examples}</p>}
            {tag.via && <p class="cv">Controlled via: {lower(tag.via)}</p>}
          </a>
        ) : <span></span>;
      })}
    </>
  ))}
</div>

<style>
  .quad { display: grid; gap: 8px; }
  .ax { font-family: Geist, sans-serif; font-size: 13px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; align-self: end; padding-bottom: 4px; }
  .rl { font-size: 13px; color: var(--muted); align-self: center; }
  .cell { display: grid; gap: 8px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); align-content: start; }
  .cell:hover { border-color: var(--line-strong); }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .nm { font-family: "Geist Serif", serif; font-size: 16px; font-weight: 600; line-height: 1.4; }
  .cell:hover .nm { color: var(--accent-text); }
  .ct { font-family: Geist, sans-serif; font-size: 13px; color: var(--faint); }
  .ex { font-size: 13px; color: var(--muted); line-height: 1.5; }
  .cv { font-size: 13px; color: var(--faint); }
  .pos { display: none; font-size: 13px; color: var(--faint); }
  /* Phones: one column; each cell names its own row and column instead of the axis labels. */
  @media (max-width: 760px) {
    .quad { grid-template-columns: minmax(0, 1fr) !important; }
    .ax, .rl, .quad > span:empty { display: none; }
    .pos { display: block; }
  }
</style>

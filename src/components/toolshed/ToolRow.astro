---
// One row of All tools: name, site and categories. Reviewed tools open their review; the rest link out.
import Rating from './Rating.astro';
import { hasReview, toolHref, type Tool } from '../../utils/content';

interface Props { tool: Tool; hidden?: boolean; }
const { tool, hidden = false } = Astro.props;
const review = hasReview(tool) ? tool.review : undefined;
const host = new URL(tool.url).hostname.replace(/^www\./, '');
---

<a
  class="trow"
  href={review ? toolHref(tool) : tool.url}
  data-tool
  hidden={hidden}
  data-search={`${tool.name} ${host} ${tool.categories.join(' ')} ${tool.tags.join(' ')}`.toLowerCase()}
  {...(review ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
>
  <span><span style="font-weight: 500;">{tool.name}</span>{tool.affiliated && <span class="emp">My employer</span>}{review?.data.rating && <> <Rating rating={review.data.rating} /></>}</span>
  <span class="h">{review?.data.verdict ?? host}</span>
  <span class="cats">{tool.categories.join(' · ')}</span>
  <span class="faint" aria-hidden="true">{review ? '→' : '↗'}</span>
  {!review && <span class="vh"> (opens in a new tab)</span>}
</a>

---
// Frame for every page inside a category: sidebar, title, summary and the Overview / Tools / Market guide tabs.
import Sidebar from './Sidebar.astro';
import { toolSlug, type ToolCategory } from '../../data/toolshed';
import type { Tool } from '../../utils/content';

interface Props {
  tools: Tool[];
  category: ToolCategory;
  tab?: 'overview' | 'tools' | 'market';
  summary?: string;
  title?: string;
}

const { tools, category, tab, summary, title = category } = Astro.props;
const base = `/toolshed/${toolSlug(category)}`;
const count = tools.filter((tool) => tool.categories.includes(category)).length;
const tabs = [
  { id: 'overview', label: 'Overview', href: base },
  { id: 'tools', label: 'Tools', href: `${base}/tools`, count },
  { id: 'market', label: 'Market guide', href: `${base}/market` },
];
---

<div class="ts-shell">
  <Sidebar tools={tools} current={category} />
  <div class="ts-shell-main">
    <header class="ts-category-header">
      <p class="ts-eyebrow"><a href="/toolshed">Toolshed</a> <span aria-hidden="true">/</span> {tab ? category : <a href={base}>{category}</a>}</p>
      <h1 class="page-heading">{title}</h1>
      {summary && <p class="ts-summary">{summary}</p>}
      {tab && (
        <nav class="ts-tabs" aria-label={`${category} sections`}>
          {tabs.map((t) => (
            <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>{t.label}{t.count !== undefined && <span>{t.count}</span>}</a>
          ))}
        </nav>
      )}
    </header>
    <slot />
  </div>
</div>

<style>
  .ts-shell { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); gap: 3rem; }
  .ts-shell-main { min-width: 0; }

  .ts-eyebrow a { color: inherit; text-decoration: none; }
  .ts-eyebrow a:hover { color: var(--color-foreground); }

  .ts-category-header { margin-bottom: 2rem; }
  .ts-summary { margin: 0.75rem 0 0; max-width: 46rem; font-size: var(--type-md); line-height: 1.55; color: var(--color-body-text); text-wrap: pretty; }

  .ts-tabs { display: flex; gap: 1.5rem; margin-top: 1.75rem; border-bottom: 1px solid var(--color-border); overflow-x: auto; }
  .ts-tabs a {
    display: inline-flex;
    gap: 0.375rem;
    padding: 0 0 0.75rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--color-muted-foreground);
    font-size: var(--type-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .ts-tabs a:hover { color: var(--color-foreground); }
  .ts-tabs a[aria-current='page'] { color: var(--color-foreground); border-bottom-color: var(--color-foreground); font-weight: 500; }
  .ts-tabs span { color: var(--color-muted-foreground); font-weight: 400; font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .ts-shell { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  }
</style>

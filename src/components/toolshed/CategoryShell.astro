---
// Frame for every page inside a category: the category list, breadcrumb, title and the
// Overview / Tools / Market guide tabs. Extra lines under the title go in the "head" slot.
import Sidebar from './Sidebar.astro';
import type { ToolCategory } from '../../toolshed/categories';
import { categoryHref, inCategory, type Tool } from '../../toolshed/tools';

interface Props {
  tools: Tool[];
  category: ToolCategory;
  tab: 'overview' | 'tools' | 'market';
  title?: string;
}

const { tools, category, tab, title = category } = Astro.props;
const base = categoryHref(category);
const tabs = [
  { id: 'overview', label: 'Overview', href: base },
  { id: 'tools', label: 'Tools', href: categoryHref(category, 'tools'), count: inCategory(tools, category).length },
  { id: 'market', label: 'Market guide', href: categoryHref(category, 'market') },
];
const crumb = tabs.find((t) => t.id === tab)!;
---

<div class="ts-shell">
  <Sidebar tools={tools} current={category} />
  <div class="ts-main">
    <div style="display: grid; gap: 12px;">
      <p class="faint" style="font-size: 13px;"><a href="/toolshed">Toolshed</a> / {tab === 'overview' ? category : <><a href={base}>{category}</a> / {crumb.label}</>}</p>
      <h1 class="title">{title}</h1>
      <slot name="head" />
    </div>
    <nav class="tabs" aria-label={`${category} sections`}>
      {tabs.map((t) => (
        <a class:list={['tab', { on: t.id === tab }]} href={t.href} aria-current={t.id === tab ? 'page' : undefined}>{t.label}{t.count !== undefined && <> <span class="faint" style="font-size: 13px;">{t.count}</span></>}</a>
      ))}
    </nav>
    <slot />
  </div>
</div>

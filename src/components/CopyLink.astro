---
interface Props { url: string; }
const { url } = Astro.props;
---
<button type="button" class="tool" id="copy-note-link" data-url={url}><span>Copy link</span></button>
<span id="copy-link-status" class="vh" role="status" aria-live="polite"></span>
<script>
  // Copies the canonical URL and says so in the button for a moment.
  const button = document.querySelector<HTMLButtonElement>('#copy-note-link');
  const status = document.getElementById('copy-link-status');
  const label = button?.querySelector('span');
  let timer: ReturnType<typeof setTimeout> | undefined;
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.url ?? location.href);
      if (status) status.textContent = 'Link copied.';
      if (label) {
        label.textContent = 'Link copied';
        label.classList.add('copied');
        clearTimeout(timer);
        timer = setTimeout(() => {
          label.textContent = 'Copy link';
          label.classList.remove('copied');
        }, 1600);
      }
    } catch {
      if (status) status.textContent = 'Copy the address from your browser instead.';
    }
  });
</script>
<style>
  .copied { color: var(--accent-text); }
</style>

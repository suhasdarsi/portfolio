<button type="button" id="reading-size" class="size-toggle" aria-pressed="false" hidden>
  <span class="size-icon" aria-hidden="true">
    A<span>A</span>
  </span>{' '}
  Larger text
</button>
<script>
  const reader = document.querySelector<HTMLElement>('[data-reader]');
  const button = document.querySelector<HTMLButtonElement>('#reading-size');
  if (reader && button) {
    function applySize(large: boolean) {
      if (!reader || !button) return;
      reader.dataset.textSize = large ? 'large' : 'comfortable';
      button.setAttribute('aria-pressed', String(large));
    }
    try {
      applySize(localStorage.getItem('reading-text-size') === 'large');
    } catch {
      applySize(false);
    }
    button.hidden = false;
    button.addEventListener('click', () => {
      const large = button.getAttribute('aria-pressed') !== 'true';
      applySize(large);
      try {
        localStorage.setItem('reading-text-size', large ? 'large' : 'comfortable');
      } catch {
        /* Reading still works without storage. */
      }
    });
  }
</script>
<style>
  .size-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-buttons);
    background: var(--color-subtle);
    color: var(--color-body-text);
    font: inherit;
    font-size: var(--type-sm);
    cursor: pointer;
  }
  .size-toggle[hidden] {
    display: none;
  }
  .size-toggle:hover,
  .size-toggle[aria-pressed='true'] {
    background: var(--color-muted);
    color: var(--color-foreground);
  }
  .size-icon {
    font-size: 0.75rem;
    letter-spacing: -0.08em;
  }
  .size-icon span {
    font-size: 1rem;
  }
</style>

---
// The <head> every page shares: meta, social cards, CSP, fonts and the theme set before paint.
import '@fontsource-variable/inter';
import '../styles/global.css';
import ThemeInit from './ThemeInit.astro';
import { cleanPath } from '../utils/clean-path';

export interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  author?: string;
  // Pages with a Turnstile widget must let Cloudflare's challenge script and frame load.
  turnstile?: boolean;
}

const { title, description, ogType = 'website', ogImage, noindex = false, author = 'Suhas Darsi', turnstile = false } = Astro.props;
const challenges = turnstile ? ' https://challenges.cloudflare.com' : '';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suhasdarsi.com';
const canonicalUrl = `${siteUrl}${cleanPath(Astro.url.pathname)}`;
const ogDescription = description || 'Suhas Darsi — practical writing about AI security, agent systems, and network risk.';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content="Astro" />
<meta name="description" content={ogDescription} />
<meta name="author" content={author} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Suhas Darsi" />
{ogImage && <>
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />
</>}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content="@suhas_darsi" />
<meta name="twitter:creator" content="@suhas_darsi" />
<meta name="theme-color" content="#f6f6f8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f0f11" media="(prefers-color-scheme: dark)" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Suhas Darsi — Notes" href="/rss.xml" />
<meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com${challenges}; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com/cdn-cgi/rum; frame-src ${turnstile ? challenges.trim() : "'none'"}; object-src 'none'; base-uri 'self'; form-action 'self';`} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<title>{title}</title>
<ThemeInit />

---
import { formatDateWithYear } from '../utils/date';
interface Props { revisions: { date: Date; summary: string }[] }
const revisions = [...Astro.props.revisions].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
{revisions.length > 0 && (
  <details class="revision-history">
    <summary>Revision history</summary>
    <ol>
      {revisions.map((revision) => (
        <li><time datetime={revision.date.toISOString()}>{formatDateWithYear(revision.date)}</time><p>{revision.summary}</p></li>
      ))}
    </ol>
  </details>
)}
<style>
  .revision-history { margin-top: 3rem; }
  summary { cursor: pointer; font-weight: 500; }
  li { margin-top: 1rem; }
  time { color: var(--color-muted-foreground); font-size: var(--type-sm); }
  p { margin: .25rem 0 0; }
</style>

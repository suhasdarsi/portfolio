---
import { formatDate } from '../site/format';
interface Props { revisions: { date: Date; summary: string }[] }
const revisions = [...Astro.props.revisions].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
{revisions.length > 0 && (
  <details class="revision-history">
    <summary>Revision history</summary>
    <ol>
      {revisions.map((revision) => (
        <li><time datetime={revision.date.toISOString()}>{formatDate(revision.date, { year: true })}</time><p>{revision.summary}</p></li>
      ))}
    </ol>
  </details>
)}
<style>
  .revision-history { font-size: 13px; color: var(--muted); }
  summary { cursor: pointer; color: var(--ink); }
  ol { margin: 8px 0 0; padding-left: 16px; display: grid; gap: 8px; }
  time { color: var(--faint); }
  p { margin: 0; color: var(--body); }
</style>

---

<div class="reading-progress-container" aria-hidden="true">
  <div class="reading-progress-bar" id="reading-progress"></div>
</div>

<script>
  function updateReadingProgress() {
    const progressBar = document.getElementById('reading-progress');
    if (!progressBar) return;

    const article = document.querySelector('article');
    if (!article) return;

    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const articleTop = article.getBoundingClientRect().top + scrollTop;
    const articleHeight = article.offsetHeight;
    const windowHeight = window.innerHeight;

    const scrollableDistance = articleHeight - windowHeight;
    const progress = scrollableDistance <= 0
      ? 100
      : Math.min(100, Math.max(0, ((scrollTop - articleTop) / scrollableDistance) * 100));

    progressBar.style.width = `${progress}%`;

  }

  let progressScheduled = false;

  function scheduleReadingProgress() {
    if (progressScheduled) return;
    progressScheduled = true;
    const frame = typeof requestAnimationFrame === 'function'
      ? requestAnimationFrame
      : (callback: FrameRequestCallback) => { callback(0); return 0; };
    frame(() => {
      progressScheduled = false;
      updateReadingProgress();
    });
  }

  window.addEventListener('scroll', scheduleReadingProgress, { passive: true });
  window.addEventListener('resize', scheduleReadingProgress, { passive: true });
  document.addEventListener('DOMContentLoaded', updateReadingProgress);
</script>

<style>
  .reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 1000;
    background-color: transparent;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background-color: var(--color-foreground);
    transition: width 0.1s ease-out;
  }

  :global(html.dark) .reading-progress-bar {
    background-color: var(--color-muted-foreground);
  }
</style>

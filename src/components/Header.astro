---
import { cleanPath } from '../utils/clean-path';
import { primaryCta } from '../data/site-navigation';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  showSearch?: boolean;
  wide?: boolean;
}

const { showSearch = true, wide = false } = Astro.props;
// Tabs as in Tempo's list view: the current page reads dark, the rest stay grey.
// Your name is the first tab and leads home.
const path = cleanPath(Astro.url.pathname);
const isHome = path === '/';
const links = [
  { label: 'Notes', href: '/notes' },
  { label: 'About', href: '/about' },
  { label: 'Uses', href: '/uses' },
];
---

<header class="header">
  <div class:list={['header-inner', { wide }]}>
    <nav class="header-nav" aria-label="Site">
      <a
        href="/"
        class="nav-tab home-link"
        aria-label="Suhas Darsi, home"
        aria-current={isHome ? 'page' : undefined}
      >
        Suhas Darsi
      </a>
      {links.map((link) => (
        <a
          href={link.href}
          class="nav-tab"
          aria-current={path === link.href || path.startsWith(`${link.href}/`) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a href={primaryCta.href} target="_blank" rel="noopener noreferrer" class="button header-cta">
        {primaryCta.label}
      </a>
      {showSearch && (
        <button
          type="button"
          class="search-trigger"
          id="global-search-toggle"
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="global-search-overlay"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="search-trigger-icon"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
        </button>
      )}
      <ThemeToggle />
    </div>
  </div>
</header>

{showSearch && (
  <>
    <div
      class="search-overlay"
      id="global-search-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Search site"
      aria-hidden="true"
      inert
      hidden
    >
      <div class="search-dialog">
        <div class="search-input-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="search-dialog-icon"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
          <input
            type="text"
            id="global-search-input"
            class="search-input-dialog"
            placeholder="Search notes..."
            aria-label="Search site"
            autocomplete="off"
          />
          <button
            type="button"
            class="search-close"
            id="global-search-close"
            aria-label="Close search"
          >
            Close
          </button>
        </div>
        <p class="search-status" role="status" id="global-search-status"></p>
        <div class="search-results" id="global-search-results"></div>
        <p class="search-empty hidden" id="global-search-empty">
          No notes found.
        </p>
        <a class="search-all" id="search-all" href="/notes">
          Browse or share this search
        </a>
        <div class="search-footer">
          <span>
            <kbd>↑</kbd>
            <kbd>↓</kbd> navigate
          </span>
          <span>
            <kbd>↵</kbd> open
          </span>
          <span>
            <kbd>Esc</kbd> close
          </span>
        </div>
      </div>
    </div>
  </>
)}

<script>
  import { highlightText, searchExcerpt } from '../utils/search-display';
  import { searchDocuments } from '../utils/client-search';
  import { createSearchLoader, debounce } from '../utils/search-loader';

  const searchToggle = document.getElementById('global-search-toggle');
  const searchOverlay = document.getElementById('global-search-overlay');
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
  const searchResults = document.getElementById('global-search-results');
  const searchEmpty = document.getElementById('global-search-empty');
  const searchStatus = document.getElementById('global-search-status');
  let activeResultIndex = -1;

  type SearchPost = {
    href: string;
    title: string;
    description?: string;
    body?: string;
  };

  let searchPosts: SearchPost[] = [];
  const loadSearchPosts = createSearchLoader<SearchPost>();

  async function refreshSearchPosts() {
    searchPosts = await loadSearchPosts();
  }

  function getResultItems() {
    return Array.from(
      searchResults?.querySelectorAll<HTMLAnchorElement>('.search-result-item') || []
    );
  }

  function setActiveResult(index: number, moveFocus = false) {
    const items = getResultItems();
    if (items.length === 0) {
      activeResultIndex = -1;
      return;
    }

    const safeIndex = Math.max(0, Math.min(index, items.length - 1));
    activeResultIndex = safeIndex;
    items.forEach((item, itemIndex) => item.classList.toggle('active', itemIndex === safeIndex));
    items[safeIndex]?.scrollIntoView({ block: 'nearest' });
    if (moveFocus) items[safeIndex]?.focus();
  }

  function renderResults(items: SearchPost[], query = '') {
    if (!searchResults) return;
    if (getResultItems().includes(document.activeElement as HTMLAnchorElement))
      searchInput?.focus();
    searchResults.replaceChildren();

    items.forEach((post) => {
      const link = document.createElement('a');
      link.href = post.href;
      link.className = 'search-result-item';

      const title = document.createElement('span');
      title.className = 'search-result-title';
      highlightText(title, post.title, query);
      const excerpt = document.createElement('span');
      excerpt.className = 'search-result-excerpt';
      highlightText(excerpt, searchExcerpt(post.body ?? '', query, post.description), query);

      link.append(title, excerpt);
      searchResults.appendChild(link);
    });

    setActiveResult(items.length > 0 ? 0 : -1);
  }

  function getFocusableElements(): HTMLElement[] {
    if (!searchOverlay) return [];
    return Array.from(
      searchOverlay.querySelectorAll<HTMLElement>(
        'input, button, [tabindex]:not([tabindex="-1"]), a[href]'
      )
    );
  }

  function announce(message: string) {
    if (searchStatus) searchStatus.textContent = message;
  }

  function showEmpty(message: string | null) {
    if (!searchEmpty) return;
    if (message === null) {
      searchEmpty.textContent = 'No notes found.';
      searchEmpty.classList.add('hidden');
    } else {
      searchEmpty.textContent = message;
      searchEmpty.classList.remove('hidden');
    }
  }

  async function openSearch() {
    searchOverlay?.removeAttribute('hidden');
    searchOverlay?.classList.add('open');
    searchOverlay?.removeAttribute('inert');
    searchOverlay?.setAttribute('aria-hidden', 'false');
    searchToggle?.setAttribute('aria-expanded', 'true');
    searchInput?.focus();
    document.body.style.overflow = 'hidden';
    showEmpty('Loading notes…');
    announce('Loading notes');
    try {
      await refreshSearchPosts();
      if (!searchOverlay?.classList.contains('open')) return;
      renderResults(searchPosts);
      showEmpty(null);
      announce(`${searchPosts.length} notes`);
    } catch {
      searchResults?.replaceChildren();
      showEmpty('Search is unavailable. Please try again.');
      announce('Search is unavailable');
    }
  }

  function closeSearch() {
    searchOverlay?.classList.remove('open');
    searchOverlay?.setAttribute('inert', '');
    searchOverlay?.setAttribute('aria-hidden', 'true');
    searchOverlay?.setAttribute('hidden', '');
    searchToggle?.setAttribute('aria-expanded', 'false');
    if (searchInput) searchInput.value = '';
    document.getElementById('search-all')?.setAttribute('href', '/notes');
    searchResults?.replaceChildren();
    searchEmpty?.classList.add('hidden');
    activeResultIndex = -1;
    document.body.style.overflow = '';
    searchToggle?.focus();
  }

  const handleSearchToggle = () => openSearch();
  const handleOverlayClick = (e: Event) => {
    if (e.target === searchOverlay) closeSearch();
  };

  searchToggle?.addEventListener('click', handleSearchToggle);
  document.getElementById('global-search-close')?.addEventListener('click', closeSearch);
  searchOverlay?.addEventListener('click', handleOverlayClick);

  const handleSearchInput = debounce(async () => {
    try {
      await refreshSearchPosts();
    } catch {
      searchResults?.replaceChildren();
      showEmpty('Search is unavailable. Please try again.');
      announce('Search is unavailable');
      return;
    }
    if (!searchOverlay?.classList.contains('open')) return;
    const query = searchInput.value.trim();
    const allLink = document.getElementById('search-all');
    allLink?.setAttribute('href', query ? `/notes?q=${encodeURIComponent(query)}` : '/notes');
    if (!query) {
      renderResults(searchPosts);
      showEmpty(null);
      announce(`${searchPosts.length} notes`);
      return;
    }

    const results = searchDocuments(searchPosts, query);
    if (results.length === 0) {
      searchResults?.replaceChildren();
      showEmpty('No notes match. Try fewer or different words.');
      announce('No notes found');
      setActiveResult(-1);
      return;
    }

    renderResults(results, query);
    showEmpty(null);
    announce(`${results.length} ${results.length === 1 ? 'note' : 'notes'} found`);
  });

  searchInput?.addEventListener('input', () => void handleSearchInput());

  const handleKeydown = (e: KeyboardEvent) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      if (!searchOverlay) return;
      e.preventDefault();
      searchOverlay?.classList.contains('open') ? closeSearch() : openSearch();
      return;
    }

    if (!searchOverlay?.classList.contains('open')) return;

    if (e.key === 'Tab') {
      const focusable = getFocusableElements();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!focusable.includes(document.activeElement as HTMLElement)) {
        e.preventDefault();
        (e.shiftKey ? last : first).focus();
      } else if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const items = getResultItems();
      if (items.length === 0) return;
      setActiveResult(activeResultIndex < 0 ? 0 : activeResultIndex + 1, true);
      return;
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault();
      const items = getResultItems();
      if (items.length === 0) return;
      setActiveResult(activeResultIndex < 0 ? items.length - 1 : activeResultIndex - 1, true);
      return;
    }

    if (e.key === 'Enter' && document.activeElement === searchInput) {
      e.preventDefault();
      const items = getResultItems();
      if (items.length === 0) return;
      const targetIndex = activeResultIndex >= 0 ? activeResultIndex : 0;
      items[targetIndex]?.click();
      return;
    }

    if (e.key === 'Escape') closeSearch();
  };

  document.addEventListener('keydown', handleKeydown);

  window.addEventListener('beforeunload', () => {
    document.removeEventListener('keydown', handleKeydown);
    searchToggle?.removeEventListener('click', handleSearchToggle);
    searchOverlay?.removeEventListener('click', handleOverlayClick);
  });
</script>

<style>
  /* Tempo's list-view nav: plain text tabs on the grey desk, one outlined action, bare icons. */
  .header {
    position: relative;
    z-index: 50;
  }

  .header-inner {
    max-width: var(--max-width-shell);
    margin: 0 auto;
    padding: 0 1rem;
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-width: 0;
  }

  .nav-tab {
    padding: 0.25rem 0;
    color: var(--color-muted-foreground);
    font-size: var(--type-base);
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-tab:hover {
    color: var(--color-foreground);
  }

  .nav-tab[aria-current='page'] {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .header-inner.wide {
    max-width: 72rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header-cta {
    min-height: 2.25rem;
    margin-right: 0.5rem;
    padding: 0 0.875rem;
  }

  /* On phones the outlined CTA moves into the home panel and the tabs tighten up. */
  @media (max-width: 520px) {
    .header-cta {
      display: none;
    }
    .header-inner {
      padding-inline: 0.75rem;
      gap: 0.5rem;
    }
    .header-nav {
      gap: 1rem;
    }
    .nav-tab {
      font-size: var(--type-sm);
    }
  }

  /* Fingers need real targets; cursors do not. */
  @media (pointer: coarse) {
    .theme-toggle,
    .search-trigger {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    border-radius: var(--radius-buttons);
    background: transparent;
    color: var(--color-muted-foreground);
    cursor: pointer;
    width: 2.25rem;
    height: 2.25rem;
    justify-content: center;
    padding-inline: 0;
    padding-block: 0;
    box-shadow: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      scale 0.15s ease;
  }

  .search-trigger:active {
    scale: 0.97;
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
  }

  .search-trigger:hover {
    color: var(--color-foreground);
    background: var(--color-muted);
  }

  .search-trigger-icon {
    width: 1rem;
    height: 1rem;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-overlay);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 18vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-dialog {
    width: 100%;
    max-width: 38rem;
    margin: 0 1rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3);
    /* Enters from the trigger above; leaves faster than it arrived. */
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .search-overlay.open .search-dialog {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.2s cubic-bezier(0.2, 0, 0, 1),
      transform 0.2s cubic-bezier(0.2, 0, 0, 1);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-bottom: 0;
    gap: 0.75rem;
  }

  .search-dialog-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-muted-foreground);
    flex-shrink: 0;
  }

  .search-close {
    min-height: 2.75rem;
    padding: 0.375rem 0.5rem;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
  }

  .search-input-dialog {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font-family: var(--font-sans);
    font-size: var(--type-base);
    color: var(--color-foreground);
    outline: none;
  }

  .search-input-dialog::placeholder {
    color: var(--color-muted-foreground);
  }

  .search-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-results {
    max-height: 60vh;
    padding: 0.375rem;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .search-results::-webkit-scrollbar {
    display: none;
  }

  @keyframes result-in {
    from {
      opacity: 0;
    }
  }

  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    padding: 0.8rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    border-bottom: 0;
    animation: result-in 0.12s ease-out;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.active),
  :global(.search-result-item:focus-visible) {
    background-color: var(--color-muted);
  }

  :global(.search-result-item:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
  }

  :global(.search-result-title) {
    font-family: var(--font-sans);
    font-size: var(--type-base);
    font-weight: 400;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-result-excerpt) {
    font-size: var(--type-sm);
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
  .search-all {
    display: block;
    padding: 0.75rem 1rem;
    font-size: var(--type-sm);
  }

  .search-empty {
    font-family: var(--font-serif);
    font-size: var(--type-base);
    font-style: italic;
    color: var(--color-muted-foreground);
    padding: 2rem 1rem;
    text-align: center;
  }

  .search-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--color-subtle-border);
    color: var(--color-muted-foreground);
    font-size: var(--type-base);
  }

  /* The hints describe keyboard behavior that does not exist on touch. */
  @media (hover: none), (pointer: coarse) {
    .search-footer {
      display: none;
    }
  }

  .search-footer kbd {
    border: 1px solid var(--color-subtle-border);
    background: var(--color-muted);
    color: inherit;
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
    font-family: inherit;
    font-size: var(--type-sm);
    margin-right: 0.25rem;
  }
</style>
